<template>
  <view class="page phoneme-compare">
    <RequestState v-if="unit == null" :error="error" @retry="loadSession" />
    <template v-else>
      <LessonProgress :current="current" :total="total" />
      <text class="phoneme-compare__category">{{ unit!.content!.category }}</text>
      <text class="page-title">{{ unit!.content!.title }}</text>
      <text class="phoneme-compare__intro">{{ unit!.content!.description }}</text>
      <PhonemeComparison :items="sounds" />
      <WordPairPlayer v-for="(pair, index) in wordPairs" :key="index" :items="pair" />
      <TipCard title="记忆技巧" :text="unit!.content!.memoryTip" variant="memory" />
      <StepActions
        :current="current"
        :total="total"
        @change="loadStep"
        @complete="completeCurrentStage"
      />
    </template>
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import RequestState from '../../components/RequestState/index.uvue'
import LessonProgress from '../../components/LessonProgress/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
import { useLearningSession } from '../../src/composables/use-learning-session.uts'
import TipCard from '../../components/TipCard/index.uvue'
import PhonemeComparison from '../../components/PhonemeComparison/index.uvue'
import WordPairPlayer from '../../components/WordPairPlayer/index.uvue'
import type { CompareContent } from '../../src/config/api-types.uts'

const { unit, current, total, error, loadSession, loadStep, completeCurrentStage } =
  useLearningSession<CompareContent>('phoneme-compare')
const sounds = computed(() =>
  (unit.value?.content.phonemes ?? []).map((item, index) => ({
    ipa: item.ipa,
    segments: [{ text: item.ipa, tone: index === 0 ? 'primary' : 'success' }],
    name: item.description,
    audioUrl: item.audioUrl ?? '',
    toneColor: index === 0 ? '#3154ff' : '#27a778',
    mouthType: item.mouth.type,
    tone: index === 0 ? 'primary' : 'success',
    tip: item.description,
    examples: item.examples.join(' · '),
  }))
)
const wordPairs = computed(() =>
  (unit.value?.content.audioPairs ?? []).map((pair) =>
    [pair.left, pair.right].map((word) => ({
      word: word.word,
      audioUrl: word.audioUrl ?? '',
      segments: [],
    }))
  )
)
</script>
<style lang="scss">
@import '../../uni.scss';

.phoneme-compare {
  &__category {
    display: block;
    margin-top: 22rpx;
    color: $color-text-secondary;
    font-size: 27rpx;
  }

  .page-title {
    display: block;
    margin-top: 8rpx;
  }

  &__intro {
    display: block;
    margin-top: 8rpx;
    color: $color-text-secondary;
    font-size: 26rpx;
  }

  &__pair-hint {
    display: block;
    margin-top: 14rpx;
    color: $color-text-secondary;
    text-align: center;
    font-size: 23rpx;
  }
}
</style>
