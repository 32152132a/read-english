// 自编的中文联想仅辅助记忆，不是汉字与 IPA 的等音对应。
// 符号和例音参考：https://dictionary.cambridge.org/help/phonetics.html
const phonemeHints: Record<string, string> = {
  'ɪ': '像轻轻说一个短“衣”，但更放松、嘴稍张开，不要拉长。',
  'iː': '联想“衣——”，嘴角稍展开，声音保持平稳。',
  'e': '从“诶”联想，嘴稍张开，只留一个短音，不要滑向“衣”。',
  'æ': '从“诶”的感觉出发，把嘴张得更大；不是完整的“哎”。',
  'ɜː': '联想不卷舌的“呃——”，嘴唇放松；这里提示的是英式读法。',
  'ə': '像很轻、很短的“呃”，一带而过，不要用力。',
  'ʌ': '联想短促的“啊”，嘴自然张开，舌头不要压得太低。',
  'ɑː': '像张嘴说“啊——”，舌头放低、偏后，声音拉长。',
  'ɒ': '从短“啊”联想，再把嘴唇收圆；不是普通话的“哦”。',
  'ɔː': '联想“哦——”的圆唇感觉，嘴张得稍大，保持一个音。',
  'ʊ': '像短“乌”，但嘴唇和舌头更放松，不要用力噘嘴。',
  'uː': '联想“乌——”，嘴唇收圆，保持声音，不要多加一个音。',
  'eɪ': '联想“诶”，从较开的口型滑向短“衣”，连成一个音。',
  'aɪ': '联想“爱”，从“啊”滑向短“衣”，不要分成两拍。',
  'ɔɪ': '从圆唇的“哦”滑向短“衣”，连成一个音。',
  'əʊ': '联想“欧”，从放松的中间音滑向“乌”，这是英式提示。',
  'aʊ': '联想“奥”，从“啊”滑向“乌”，结尾不要用力。',
  'ɪə': '从放松的短“衣”滑向轻“呃”，两段连在一起，不卷舌。',
  'eə': '从张口的“诶”滑向轻“呃”，不要读成“爱”，不卷舌。',
  'ʊə': '从放松的短“乌”滑向轻“呃”，不卷舌；这是传统英式记法。',
  'p': '取“坡”开头的气声，双唇打开就收住，不带后面的“哦”。',
  'b': '取“波”开头的闭唇动作，轻轻发声，不带“哦”；不同于普通话声母。',
  't': '取“特”开头的气声，舌尖放开就收住，不带后面的“呃”。',
  'd': '取“的”开头的舌尖动作，轻轻发声，不带后面的元音。',
  'k': '取“科”开头的气声，舌后部放开就收住，不带“哦”。',
  'ɡ': '取“哥”开头的舌后部动作，轻轻发声，不带后面的元音。',
  'f': '像轻轻吹气的“夫”，只留摩擦气声，不带“乌”。',
  'v': '从“夫”的气声联想，上齿轻碰下唇，同时让喉咙振动，不是“乌”。',
  'θ': '没有合适的中文同音：舌尖轻放上下齿之间，吹出气声，不要读成“思”。',
  'ð': '和 /θ/ 一样轻露舌尖，再让喉咙振动；不要读成“的”或“兹”。',
  's': '像“嘶——”的漏气声，只留气流，不带后面的元音。',
  'z': '从“嘶”的气声联想，再让喉咙振动；不是完整的“兹”。',
  'ʃ': '像让人安静时“嘘”的气声，但不带“乌”，舌头不要像“诗”那样卷起。',
  'ʒ': '从 /ʃ/ 的气声联想，再让喉咙振动；中文没有直接对应音。',
  'h': '像对着玻璃轻轻哈气，只留“哈”开头的气声，不带“啊”。',
  'tʃ': '联想“吃”开头的破擦声，但不卷舌，不带后面的元音。',
  'dʒ': '和 /tʃ/ 的动作相近，加上喉咙振动；不要直接读成“知”或“鸡”。',
  'm': '像闭嘴发“嗯——”，双唇保持合拢，声音从鼻腔出来。',
  'n': '像“呢”开头的鼻音，舌尖抵住上齿龈，不带后面的“呃”。',
  'ŋ': '联想“昂”末尾的鼻音，只保留后半段，不加“啊”或“哥”。',
  'l': '取“了”开头的感觉，舌尖抵住上齿龈，不带后面的“呃”。',
  'r': '可从“日”的舌头后抬感觉联想，但舌尖不碰上腭，不摩擦，也不带元音。',
  'j': '像“呀”开头一闪而过的“衣”感，立刻接后面的音，不单独拉长。',
  'w': '像“哇”开头的圆唇动作，随即放开，不把“乌”单独读出来。',
  'tr': '先做 /t/，马上接 /r/，连在一起；不要读成“特—瑞”两拍。',
  'dr': '先做 /d/，马上接 /r/，连在一起；不要在中间加“呃”。',
  'ts': '联想“次”开头的感觉，先 /t/ 后 /s/ 连起来，不带后面的元音。',
  'dz': '先 /d/ 后 /z/ 连起来，让喉咙振动；不是完整的“兹”。',
}

export function getPhonemeHint(ipa: string): string {
  const symbol = ipa.replace(/[/\[\]]/g, '').trim().replace(/g/g, 'ɡ')
  return phonemeHints[symbol] ?? '这个音没有合适的中文拟音，请结合下面的发音说明理解。'
}
