<template>
  <view class="step-actions">
    <text v-if="hint.length > 0" class="step-actions__hint" @click="$emit('hint-click')">
      {{ hint }}　›
    </text>
    <view class="step-actions__buttons">
      <button
        class="outline-button step-actions__button"
        :class="isFirst ? 'is-disabled' : ''"
        :disabled="isFirst"
        @click="changeStep(-1)"
      >
        上一步
      </button>
      <button
        class="primary-button step-actions__button"
        :class="isUnavailable ? 'is-disabled' : ''"
        :disabled="isUnavailable"
        @click="changeStep(1)"
      >
        {{ isLast ? '下一阶段' : '下一步' }}
      </button>
    </view>
  </view>
</template>

<script setup lang="uts">
import type { StepActionsProps } from '../../src/config/types.uts'

const props = withDefaults(defineProps<StepActionsProps>(), { hint: '' })
const emit = defineEmits(['change', 'complete', 'hint-click'])
const isFirst = computed((): boolean => props.total <= 0 || props.current <= 1)
const isLast = computed((): boolean => props.total <= 0 || props.current >= props.total)
const isUnavailable = computed((): boolean => props.total <= 0)

function changeStep(offset: number) {
  if (offset > 0 && isLast.value) {
    emit('complete')
    return
  }
  const target = props.current + offset
  if (target < 1 || target > props.total) return

  emit('change', target)
  uni.pageScrollTo({ scrollTop: 0, duration: 200 })
}
</script>

<style lang="scss">
@import '../../uni.scss';

.step-actions {
  margin-top: 32rpx;

  &__hint {
    display: block;
    margin-bottom: 22rpx;
    color: $color-primary;
    text-align: left;
    font-size: 24rpx;
  }

  &__buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24rpx;
  }

  &__button {
    width: 100%;
    margin: 0;
  }
}
</style>
