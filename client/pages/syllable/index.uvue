<template>
  <view class="page">
    <RequestState v-if="unit == null" :error="error" @retry="loadSession" />
    <template v-else>
      <LessonProgress :current="current" :total="total" />
      <text class="page-title">{{ unit!.content!.lessonTitle }}</text>
      <text class="muted">{{ unit!.content!.description }}</text>
      <TipCard title="记忆小贴士" :text="unit!.content!.memoryTip" />
      <SegmentedWord :parts="parts" separator="·" />
      <InfoSteps title="怎么判断" :items="rules" />
      <SyllableQuiz
        :key="unit!.id"
        :data="question"
        :disabled="submitting"
        @answer="submitAnswer"
      />
      <TipCard v-if="answer != null" :text="answer!.explanation" />
      <StepActions
        v-if="answer != null"
        :current="current"
        :total="total"
        @change="loadStep"
        @complete="completeCurrentStage"
      />
    </template>
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import RequestState from '../../components/RequestState/index.uvue'
import LessonProgress from '../../components/LessonProgress/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
import { useLearningSession } from '../../src/composables/use-learning-session.uts'
import TipCard from '../../components/TipCard/index.uvue'
import SegmentedWord from '../../components/SegmentedWord/index.uvue'
import InfoSteps from '../../components/InfoSteps/index.uvue'
import SyllableQuiz from '../../components/SyllableQuiz/index.uvue'
import { useQuizAnswer } from '../../src/composables/use-quiz-answer.uts'
import type { SyllableContent } from '../../src/config/api-types.uts'

const { session, unit, current, total, error, loadSession, loadStep, completeCurrentStage } =
  useLearningSession<SyllableContent>('syllable')
const { answer, submitting, submitAnswer } = useQuizAnswer(
  () => session.value?.sessionId ?? '',
  () => unit.value?.content.question.questionId ?? ''
)
const parts = computed(() =>
  (unit.value?.content.segments ?? []).map((text) => ({ text, emphasized: false }))
)
const rules = computed(() =>
  (unit.value?.content.rules ?? []).map((text) => ({ title: text, text: '' }))
)
const question = computed(() => ({
  id: unit.value?.content.question.questionId ?? '',
  text: unit.value?.content.question.prompt ?? '',
  options: (unit.value?.content.question.options ?? []).map((item) => ({
    label: item.id,
    text: item.label,
    value: item.id,
  })),
  correctValue: answer.value?.correctOptionId ?? '',
}))
</script>
