<template>
  <view class="screen">
    <view class="page profile">
      <text class="title">{{ pageData.title }}</text>
      <UserSummary v-if="loaded" :data="pageData.user" />
      <RequestState v-else :error="error" @retry="loadProfile" />
      <LearningStats v-if="loaded" :items="pageData.stats" />
      <text class="section-title">我的学习</text>
      <ProfileMenu :items="pageData.learning" @select="handleMenu" />
      <text class="section-title">设置</text>
      <ProfileMenu :items="pageData.settings" @select="handleMenu" />
      <text class="version">{{ pageData.version }}</text>
    </view>
    <BottomNav active="profile" />
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import BottomNav from '../../components/BottomNav/index.uvue'
import UserSummary from '../../components/UserSummary/index.uvue'
import LearningStats from '../../components/LearningStats/index.uvue'
import ProfileMenu from '../../components/ProfileMenu/index.uvue'
import RequestState from '../../components/RequestState/index.uvue'
import { request, showRequestError } from '../../src/services/http.uts'
import { logout } from '../../src/services/auth.uts'
import type { UserProfile, UserStats } from '../../src/config/api-types.uts'
import type { HttpError } from '../../src/config/types.uts'
import { setAccentPreference } from '../../src/services/accent.uts'

const loaded = ref(false)
const error = ref('')

const pageData = reactive({
  title: '我的',
  user: { avatarText: 'YQ', nickname: '', learningStatus: '正在完成基础学习' },
  stats: [
    { code: 'learned', label: '已学习', value: 0, suffix: '' },
    { code: 'streak', label: '连续学习', value: 0, suffix: '天' },
  ],
  learning: [
    { code: 'content', iconName: 'book-open', label: '内容维护' },
    { code: 'libraries', iconName: 'book-open', label: '我的词库' },
    { code: 'learning-flow', iconName: 'workflow', label: '学习流程' },
  ],
  settings: [
    {
      code: 'accent',
      iconName: 'volume-2',
      label: '发音偏好',
      value: '美式英语',
      clickable: true,
    },
    { code: 'about', iconName: 'info', label: '关于产品' },
    { code: 'logout', iconName: 'log-out', label: '退出登录', danger: true },
  ],
  version: 'v1.0.0',
})

function handleMenu(code: string) {
  if (code === 'content') {
    uni.navigateTo({ url: '/pages/content/index' })
    return
  }
  if (code === 'libraries') {
    uni.navigateTo({ url: '/pages/word-list/index' })
    return
  }
  if (code === 'learning-flow') {
    uni.navigateTo({ url: '/pages/profile/learning-flow' })
    return
  }
  if (code === 'accent') {
    chooseAccent()
    return
  }
  if (code === 'about') {
    uni.showToast({ title: '永庆发音学习 v1.0.0', icon: 'none' })
    return
  }
  if (code === 'logout') confirmLogout()
}

function chooseAccent() {
  uni.showActionSheet({
    itemList: ['美式英语', '英式英语'],
    success: async (result) => {
      const accent = result.tapIndex === 1 ? 'GB' : 'US'
      try {
        const profile = await request<UserProfile>({
          url: '/users/me/preferences',
          method: 'PATCH',
          data: { accentPreference: accent },
        })
        setAccentPreference(profile.accentPreference)
        pageData.settings[0].value = profile.accentPreference === 'GB' ? '英式英语' : '美式英语'
        uni.showToast({ title: '发音偏好已更新', icon: 'none' })
      } catch (failure) {
        showRequestError(failure)
      }
    },
  })
}

function confirmLogout() {
  uni.showModal({
    title: '退出登录',
    content: '退出后，本机登录状态将被清除。',
    confirmText: '退出',
    success: async (result) => {
      if (!result.confirm) return
      try {
        await logout()
        uni.reLaunch({ url: '/pages/home/index' })
      } catch (failure) {
        showRequestError(failure)
      }
    },
  })
}
async function loadProfile() {
  error.value = ''
  try {
    const [profile, stats] = await Promise.all([
      request<UserProfile>({ url: '/users/me', showError: false }),
      request<UserStats>({ url: '/users/me/stats', showError: false }),
    ])
    pageData.user = {
      avatarText: profile.nickname.slice(0, 2),
      nickname: profile.nickname,
      learningStatus: '一起练习英语发音',
    }
    setAccentPreference(profile.accentPreference)
    pageData.settings[0].value = profile.accentPreference === 'GB' ? '英式英语' : '美式英语'
    pageData.stats = [
      {
        code: 'learned',
        label: '已学习',
        value: stats.learnedUnits,
        suffix: '/ ' + stats.totalUnits,
      },
      { code: 'streak', label: '连续学习', value: stats.streakDays, suffix: '天' },
    ]
    loaded.value = true
  } catch (failure) {
    loaded.value = false
    error.value = (failure as HttpError).message
  }
}

onShow(loadProfile)
</script>
<style lang="scss">
@import '../../uni.scss';
.profile {
  padding-top: 110rpx;
  padding-bottom: 164rpx;
}
.title {
  font-size: 54rpx;
  font-weight: 700;
}
.version {
  display: block;
  margin: 34rpx;
  text-align: center;
  color: #a2a9bc;
}
</style>
