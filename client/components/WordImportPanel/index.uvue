<template>
  <view class="word-import">
    <text class="word-import__title">AI 定制词库</text>
    <text class="muted">
      粘贴 1–200 个单词，以逗号、空格或换行分隔。生成后先预览内容，确认无误再添加到我的词库。
    </text>
    <input v-model="name" placeholder="词库名称（2–40字）" :maxlength="40" :disabled="busy" />
    <textarea
      v-model="words"
      placeholder="computer, teacher, development"
      :maxlength="30000"
      :disabled="busy"
    />
    <text class="word-import__count" :class="tooManyWords ? 'is-over-limit' : ''">
      已输入 {{ wordCount }} / 200 个单词
    </text>
    <view v-if="parsedWords.length > 0" class="word-import__words">
      <view
        v-for="item in parsedWords"
        :key="item.word + ':' + item.position"
        class="word-import__word"
      >
        <text>{{ item.word }}</text>
      </view>
    </view>
    <button
      class="primary-button"
      :disabled="busy || !enabled || tooManyWords"
      @click="create"
    >
      {{ busy ? '正在提交' : '生成词库' }}
    </button>
    <text v-if="!enabled" class="muted">AI 生成服务当前不可用，请稍后再试。</text>
    <text v-if="error" class="word-import__error">{{ error }}</text>
    <view v-if="job" class="word-import__result">
      <view class="word-import__result-heading">
        <view class="word-import__result-copy">
          <text class="word-import__result-name">{{ job!.name }}</text>
          <text class="muted">{{ statusText(job!.status) }} · {{ job!.completed }} / {{ job!.total }}</text>
        </view>
        <view class="word-import__result-counts">
          <text class="is-success">成功 {{ job!.succeeded }}</text>
          <text :class="job!.failed > 0 ? 'is-failed' : ''">失败 {{ job!.failed }}</text>
        </view>
      </view>
      <text class="muted">生成完成后会进入词库预览，你可以逐个检查和修改。</text>
      <view v-if="failedItems.length > 0" class="word-import__failures">
        <view class="word-import__failure-heading">
          <text class="word-import__failure-title">未生成成功的单词</text>
          <text class="muted">只会重试下面的失败项</text>
        </view>
        <view v-for="item in failedItems" :key="item.position" class="word-import__failure">
          <view class="word-import__failure-copy">
            <text class="word-import__failure-word">{{ item.word }}</text>
            <text class="word-import__failure-reason">
              {{ item.errorMessage ?? '生成结果不完整，请重试' }}
            </text>
          </view>
          <text class="word-import__attempts">
            {{ item.attempts >= 3 ? '已达上限' : '已尝试 ' + item.attempts + '/3 次' }}
          </text>
        </view>
      </view>
      <button
        v-if="job!.status === 'PARTIAL_FAILED' && retryableCount > 0"
        class="outline-button"
        :disabled="busy"
        @click="retry"
      >
        {{ busy ? '正在重新提交' : '只重试这 ' + retryableCount + ' 个失败单词' }}
      </button>
      <text
        v-else-if="job!.status === 'PARTIAL_FAILED' && failedItems.length > 0"
        class="word-import__retry-limit"
      >
        失败单词均已达到 3 次尝试上限，可以稍后重新创建任务。
      </text>
    </view>
  </view>
</template>
<script setup lang="uts">
import { request, showRequestError } from '../../src/services/http.uts'
import type { ContentCapabilities, ContentJob } from '../../src/config/content-types.uts'
type ParsedWord = {
  word: string
  position: number
}
type JobItem = {
  position: number
  word: string
  status: string
  errorMessage: string | null
  attempts: number
}
type JobDetails = ContentJob & { items: JobItem[] }
const name = ref(''),
  words = ref(''),
  error = ref(''),
  enabled = ref(false),
  busy = ref(false)
const job = ref<ContentJob | null>(null)
const failedItems = ref<JobItem[]>([])
const retryableCount = computed(
  (): number => failedItems.value.filter((item) => item.attempts < 3).length
)
const parsedWords = computed((): ParsedWord[] => {
  const input = words.value.trim()
  if (!input) return []
  const result: ParsedWord[] = []
  input.split(/[\s,，;；]+/).forEach((word) => {
    if (!word) return
    result.push({ word: word.toLowerCase(), position: result.length })
  })
  return result
})
const wordCount = computed((): number => parsedWords.value.length)
const tooManyWords = computed((): boolean => wordCount.value > 200)
const invalidWords = computed((): string[] =>
  parsedWords.value
    .filter((item) => !/^[a-z]+(?:['’-][a-z]+)*$/.test(item.word))
    .map((item) => item.word)
)
let timer = 0,
  visible = false,
  navigating = false,
  requestKey = '',
  submittedInput = ''
function statusText(status: string): string {
  return (
    ((
      {
        PENDING: '等待处理',
        PROCESSING: '正在生成',
        SUCCEEDED: '生成完成',
        FAILED: '生成失败',
        PARTIAL_FAILED: '部分生成失败',
      } as UTSJSONObject
    )[status] as string) ?? status
  )
}
function clearPollTimer() {
  clearTimeout(timer)
  timer = 0
}
function stop() {
  visible = false
  clearPollTimer()
}
function updateJob(result: ContentJob) {
  job.value = result
}
async function loadFailures(id: string) {
  const details = await request<JobDetails>({
    url: '/word-libraries/custom-jobs/' + id + '/items',
    showLoading: false,
    showError: false,
  })
  if (job.value?.id === id) {
    failedItems.value = details.items.filter((item) => item.status === 'FAILED')
  }
}
function openPreview(libraryId: string) {
  if (navigating) return
  navigating = true
  stop()
  uni.redirectTo({
    url: '/pages/word-list/detail?id=' + encodeURIComponent(libraryId),
  })
}
async function poll() {
  clearPollTimer()
  const id = job.value?.id
  if (!id || !visible) return
  try {
    const result = await request<ContentJob>({
      url: '/word-libraries/custom-jobs/' + id,
      showLoading: false,
      showError: false,
    })
    if (job.value?.id !== id) return
    updateJob(result)
    if (result.status === 'SUCCEEDED') {
      failedItems.value = []
      openPreview(result.libraryId)
      return
    }
    if (result.status === 'PARTIAL_FAILED') await loadFailures(id)
    else failedItems.value = []
    error.value = ''
  } catch (e) {
    if (job.value?.id === id) error.value = (e as Error).message
  } finally {
    if (
      visible &&
      job.value?.id === id &&
      (job.value?.status === 'PENDING' || job.value?.status === 'PROCESSING')
    ) {
      clearPollTimer()
      timer = setTimeout(poll, 2000)
    }
  }
}
async function resumeActiveJob() {
  const result = await request<{ items: ContentJob[] }>({
    url: '/word-libraries/custom-jobs',
    showLoading: false,
    showError: false,
  })
  const active = result.items.find(
    (item) => item.status === 'PENDING' || item.status === 'PROCESSING' || item.status === 'PARTIAL_FAILED'
  )
  if (active != null) {
    job.value = active
    poll()
  }
}
async function create() {
  if (busy.value) return
  if (name.value.trim().length < 2) {
    error.value = '词库名称至少需要 2 个字'
    return
  }
  if (wordCount.value === 0) {
    error.value = '请至少输入 1 个单词'
    return
  }
  if (tooManyWords.value) {
    error.value = '每次最多输入 200 个单词，请删减后再生成'
    return
  }
  if (invalidWords.value.length > 0) {
    error.value = '仅支持英文单词，请检查：' + invalidWords.value.slice(0, 3).join('、')
    return
  }
  busy.value = true
  error.value = ''
  const submittedWords = parsedWords.value.map((item) => item.word)
  const input = name.value + '\n' + submittedWords.join('\n')
  if (input !== submittedInput) {
    submittedInput = input
    requestKey = 'words-' + Date.now() + '-' + Math.random().toString(36).slice(2)
  }
  try {
    failedItems.value = []
    job.value = await request<ContentJob>({
      url: '/word-libraries/custom-jobs',
      method: 'POST',
      header: { 'Idempotency-Key': requestKey },
      data: { name: name.value.trim(), words: submittedWords },
    })
    poll()
  } catch (e) {
    error.value = (e as Error).message
    showRequestError(e)
  } finally {
    busy.value = false
  }
}
async function retry() {
  if (!job.value || busy.value) return
  busy.value = true
  try {
    failedItems.value = []
    job.value = await request<ContentJob>({
      url: '/word-libraries/custom-jobs/' + job.value.id + '/retry',
      method: 'POST',
    })
    poll()
  } catch (e) {
    showRequestError(e)
  } finally {
    busy.value = false
  }
}
onShow(async () => {
  visible = true
  navigating = false
  try {
    const cap = await request<ContentCapabilities>({
      url: '/content/capabilities',
      showError: false,
    })
    enabled.value = cap.generationEnabled
    if (job.value == null) await resumeActiveJob()
    else poll()
  } catch (e) {
    error.value = (e as Error).message
  }
})
onHide(stop)
onUnmounted(stop)
</script>
<style lang="scss">
@import '../../uni.scss';
.word-import {
  gap: 24rpx;
  input,
  textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 20rpx;
    background: $color-surface;
    border: 1rpx solid $color-border;
    border-radius: 12rpx;
  }
  input {
    height: 80rpx;
  }
  textarea {
    height: 280rpx;
  }
  &__title {
    font-size: 34rpx;
    font-weight: 700;
  }
  &__result {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
    padding: 24rpx;
    border: 1rpx solid $color-border;
    border-radius: 18rpx;
    background-color: $color-surface;
  }
  &__result-heading,
  &__failure-heading {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16rpx;
  }
  &__result-copy {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4rpx;
  }
  &__result-name,
  &__failure-title,
  &__failure-word {
    font-weight: 700;
  }
  &__result-counts {
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    gap: 12rpx;
    font-size: 22rpx;

    text {
      padding: 5rpx 10rpx;
      border-radius: 999rpx;
      background-color: #f2f3f7;
    }

    .is-success {
      color: #147648;
      background-color: #effaf4;
    }

    .is-failed {
      color: #b23b45;
      background-color: #fff0f1;
    }
  }
  &__failures {
    display: flex;
    flex-direction: column;
    max-height: 420rpx;
    padding: 18rpx;
    border-radius: 14rpx;
    background-color: #fff7f7;
    gap: 12rpx;
    overflow-y: auto;
  }
  &__failure-heading {
    align-items: baseline;

    .muted {
      font-size: 21rpx;
      text-align: right;
    }
  }
  &__failure {
    padding: 14rpx;
    border: 1rpx solid #f2d6d8;
    border-radius: 12rpx;
    background-color: #fff;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 14rpx;
  }
  &__failure-copy {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4rpx;
  }
  &__failure-reason {
    color: #a94a52;
    font-size: 22rpx;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  &__attempts {
    flex-shrink: 0;
    color: $color-text-secondary;
    font-size: 20rpx;
  }
  &__retry-limit {
    color: #a94a52;
    font-size: 23rpx;
    line-height: 1.5;
  }
  &__error {
    color: #cf4040;
  }
  &__count {
    margin-top: -16rpx;
    color: $color-text-secondary;
    font-size: 24rpx;
    text-align: right;

    &.is-over-limit {
      color: #cf4040;
    }
  }
  &__words {
    max-height: 220rpx;
    padding: 16rpx;
    border: 1rpx solid $color-border;
    border-radius: 12rpx;
    background-color: $color-surface;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    align-content: flex-start;
    justify-content: flex-start;
    gap: 12rpx;
    overflow-y: auto;
  }
  &__word {
    width: fit-content;
    padding: 8rpx 12rpx;
    box-sizing: border-box;
    border: 1rpx solid $color-border;
    border-radius: 999rpx;
    background-color: #f5f6f8;
    color: $color-text-primary;
    font-size: 24rpx;
    display: inline-flex;
    flex: 0 0 auto;
    align-self: flex-start;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }
}
</style>
