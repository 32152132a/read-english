<template>
  <view class="debug-page-nav">
    <view v-if="open" class="debug-page-nav__panel">
      <view class="debug-page-nav__header">
        <text>页面调试</text>
        <text class="debug-page-nav__close" @click="toggle">关闭</text>
      </view>
      <scroll-view class="debug-page-nav__list" scroll-y>
        <view class="debug-page-nav__grid">
          <text
            v-for="item in pages"
            :key="item.route"
            class="debug-page-nav__link"
            @click="openPage(item.route)"
          >
            {{ item.label }}
          </text>
        </view>
      </scroll-view>
    </view>
    <text class="debug-page-nav__trigger" @click="toggle">{{ open ? '收起' : '页面' }}</text>
  </view>
</template>

<script lang="uts">
export default {
  data() {
    return {
      open: false,
      pages: [
        { label: '首页', route: '/pages/home/index' },
        { label: '单个音标', route: '/pages/phoneme/detail' },
        { label: '易混对比', route: '/pages/phoneme/compare' },
        { label: '听音辨认', route: '/pages/phoneme/quiz' },
        { label: '音标总览', route: '/pages/phoneme/overview' },
        { label: '音素音节', route: '/pages/syllable/index' },
        { label: '音标拼读', route: '/pages/decoding/ipa' },
        { label: '单词拆读', route: '/pages/decoding/word' },
        { label: '专业词库', route: '/pages/word-list/index' },
        { label: '跟读评测', route: '/pages/evaluation/index' },
        { label: 'AI 纠音', route: '/pages/correction/index' },
        { label: '我的', route: '/pages/profile/index' },
      ],
    }
  },
  methods: {
    toggle() {
      this.open = !this.open
    },
    openPage(route: string) {
      this.open = false
      uni.reLaunch({ url: route })
    },
  },
}
</script>

