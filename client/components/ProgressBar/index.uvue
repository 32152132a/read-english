<template>
  <view class="progress-bar">
    <view class="progress-bar__value" :style="{ width: percent + '%' }" />
  </view>
</template>

<script lang="uts">
export default {
  props: {
    current: { type: Number, required: true },
    total: { type: Number, required: true },
  },
  computed: {
    percent(): number {
      if (this.total <= 0) return 0
      return Math.min(100, Math.max(0, (this.current / this.total) * 100))
    },
  },
}
</script>

<style lang="scss">
@import '../../uni.scss';

.progress-bar {
  height: 8rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background-color: $color-border;

  &__value {
    height: 100%;
    border-radius: 8rpx;
    background-color: $color-primary;
  }
}
</style>
