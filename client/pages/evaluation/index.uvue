<template>
  <view class="page">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <EvaluationTarget :data="pageData.word" />
    <RecordingPanel
      :title="pageData.recordTitle"
      :description="pageData.recordDescription"
      @finish="evaluateRecording"
    />
    <EvaluationResult
      v-if="resultVisible"
      :title="pageData.resultTitle"
      :scores="pageData.scores"
    />
    <StepActions :current="pageData.current" :total="pageData.total" @change="loadStep" />
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
import EvaluationTarget from '../../components/EvaluationTarget/index.uvue'
import RecordingPanel from '../../components/RecordingPanel/index.uvue'
import EvaluationResult from '../../components/EvaluationResult/index.uvue'
const pageData = reactive({
  current: 2,
  total: 3,
  word: {
    id: 'component',
    word: 'component',
    ipa: '/kəmˈpəʊnənt/',
    ipaSegments: [{ text: '/kəmˈpəʊnənt/', tone: 'muted' }],
    audioUrl: '',
    stressIndex: 2,
    syllables: [
      { text: 'com', emphasized: false },
      { text: 'po', emphasized: true },
      { text: 'nent', emphasized: false },
    ],
  },
  recordTitle: '按住跟读',
  recordDescription: '读完整单词，松开后开始评测',
  resultTitle: '上次评测结果',
  scores: [
    { code: 'overall', label: '总分', value: 82, tone: 'primary' },
    { code: 'accuracy', label: '准确度', value: 78, tone: 'success' },
    { code: 'integrity', label: '完整度', value: 100, tone: 'warning' },
    { code: 'fluency', label: '流利度', value: 84, tone: 'success' },
  ],
})
const stepList = [
  {
    id: 'fantastic',
    word: 'fantastic',
    ipa: '/fænˈtæstɪk/',
    ipaSegments: [{ text: '/fænˈtæstɪk/', tone: 'muted' }],
    audioUrl: '',
    stressIndex: 2,
    syllables: [
      { text: 'fan', emphasized: false },
      { text: 'tas', emphasized: true },
      { text: 'tic', emphasized: false },
    ],
  },
  {
    id: 'component',
    word: 'component',
    ipa: '/kəmˈpəʊnənt/',
    ipaSegments: [{ text: '/kəmˈpəʊnənt/', tone: 'muted' }],
    audioUrl: '',
    stressIndex: 2,
    syllables: [
      { text: 'com', emphasized: false },
      { text: 'po', emphasized: true },
      { text: 'nent', emphasized: false },
    ],
  },
  {
    id: 'important',
    word: 'important',
    ipa: '/ɪmˈpɔːtənt/',
    ipaSegments: [{ text: '/ɪmˈpɔːtənt/', tone: 'muted' }],
    audioUrl: '',
    stressIndex: 2,
    syllables: [
      { text: 'im', emphasized: false },
      { text: 'por', emphasized: true },
      { text: 'tant', emphasized: false },
    ],
  },
]
const resultVisible = ref(true)

function evaluateRecording() {
  // 后续在这里提交录音文件并更新评测结果。
  resultVisible.value = true
}

function loadStep(target: number) {
  const step = stepList[target - 1]
  if (step == null) return

  pageData.current = target
  pageData.word = step
  resultVisible.value = false
}
</script>
