const TOKEN_KEY = 'token'
const REFRESH_TOKEN_KEY = 'refresh-token'

export function getRefreshToken(): string {
  return (uni.getStorageSync(REFRESH_TOKEN_KEY) as string) || ''
}

export function setLoginTokens(accessToken: string, refreshToken: string) {
  setToken(accessToken)
  uni.setStorageSync(REFRESH_TOKEN_KEY, refreshToken)
}

export function getToken(): string {
  const token = uni.getStorageSync(TOKEN_KEY)
  return (token as string | null)?.trim() ?? ''
}

function setToken(token: string) {
  uni.setStorageSync(TOKEN_KEY, token.trim())
}

export function clearToken() {
  uni.removeStorageSync(TOKEN_KEY)
  uni.removeStorageSync(REFRESH_TOKEN_KEY)
}

export function getAuthorization(): string {
  const token = getToken()
  if (token.length === 0) return ''

  return token.toLowerCase().startsWith('bearer ') ? token : `Bearer ${token}`
}
