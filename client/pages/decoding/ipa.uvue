<template>
  <view class="page">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <text class="page-title task">{{ pageData.title }}</text>
    <text class="main-ipa">{{ pageData.ipa }}</text>
    <view class="stages">
      <view v-for="(stage, index) in pageData.stages" :key="stage.name" class="stage-item">
        <text class="stage-number" :class="stage.active ? 'active-stage' : ''">
          {{ index + 1 }}
        </text>
        <text class="stage-label" :class="stage.active ? 'active-label' : ''">
          {{ stage.name }}
        </text>
      </view>
    </view>
    <text class="muted hint">{{ pageData.hint }}</text>
    <view class="card split">
      <template v-for="(part, index) in pageData.parts" :key="part">
        <text v-if="index > 0" class="primary">·</text>
        <text>{{ part }}</text>
      </template>
    </view>
    <view class="play-actions">
      <button class="outline-button">▶ 分段播放</button>
      <button class="outline-button">▶ 完整播放</button>
    </view>
    <view class="card answer">
      <text>🔒　对应单词</text>
      <button class="outline-button small-btn">查看答案</button>
    </view>
    <StepActions :current="pageData.current" :total="pageData.total" @change="loadStep" />
  </view>
</template>
<script lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
export default {
  components: { LessonProgress, StepActions },
  data() {
    return {
      pageData: {
        id: 'ipa-decoding-component',
        current: 4,
        total: 10,
        title: '把音标分段读出来',
        ipa: '/kəmˈpəʊnənt/',
        hint: '拖动分隔符，调整音节划分',
        stages: [
          { name: '找元音', active: false },
          { name: '分音节', active: true },
          { name: '找重音', active: false },
          { name: '连起来读', active: false },
        ],
        parts: ['kəm', 'pəʊ', 'nənt'],
        segmentedAudioUrl: '',
        fullAudioUrl: '',
        answerWord: 'component',
        nextRoute: '/pages/decoding/word',
      },
    }
  },
  methods: {
    loadStep(target: number) {
      if (target < this.pageData.current) {
        uni.navigateBack()
        return
      }
      this.next()
    },
    next() {
      uni.navigateTo({ url: this.pageData.nextRoute })
    },
  },
}
</script>
