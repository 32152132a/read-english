<template>
  <view class="page word-library-detail">
    <RequestState v-if="library == null" :error="error" @retry="loadDetail" />
    <template v-else>
      <text class="page-title">{{ library!.name }}</text>
      <text class="word-library-detail__description">{{ library!.description }}</text>
      <ExampleWordList :items="words" />
      <button v-if="hasMore" class="outline-button" :disabled="loadingMore" @click="loadWords">
        加载更多
      </button>
      <TipCard text="词库专项练习暂未开放，可以先浏览单词与音标。" />
    </template>
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import ExampleWordList from '../../components/ExampleWordList/index.uvue'
import RequestState from '../../components/RequestState/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import { request, showRequestError } from '../../src/services/http.uts'
import type { LibrarySummary, LibraryWordPage } from '../../src/config/api-types.uts'
import type { ExampleWord, HttpError } from '../../src/config/types.uts'

const library = ref<LibrarySummary | null>(null)
const words = ref<ExampleWord[]>([])
const hasMore = ref(false)
const loadingMore = ref(false)
const error = ref('')
let libraryId = ''
let cursor: string | null = null

async function loadWords() {
  if (loadingMore.value) return
  loadingMore.value = true
  try {
    const page = await request<LibraryWordPage>({
      url:
        '/word-libraries/' +
        encodeURIComponent(libraryId) +
        '/words?size=20' +
        (cursor == null ? '' : '&cursor=' + encodeURIComponent(cursor)),
    })
    words.value = words.value.concat(
      page.items.map((word) => ({
        word: word.word,
        segments: [{ text: word.ipa, tone: 'muted' }],
        zh: word.meaning,
        audioUrl: word.audioUrl ?? '',
      }))
    )
    cursor = page.nextCursor
    hasMore.value = page.hasMore
  } catch (failure) {
    hasMore.value = true
    showRequestError(failure)
  } finally {
    loadingMore.value = false
  }
}

async function loadDetail() {
  error.value = ''
  try {
    if (libraryId.length === 0) throw new Error('请从我的词库选择要查看的词库')
    library.value = await request<LibrarySummary>({
      url: '/word-libraries/' + encodeURIComponent(libraryId),
    })
    words.value = []
    cursor = null
    await loadWords()
  } catch (failure) {
    error.value = (failure as HttpError).message
  }
}

onLoad((options) => {
  libraryId = options['id'] ?? ''
  loadDetail()
})
</script>
<style lang="scss">
@import '../../uni.scss';

.word-library-detail {
  &__description {
    display: block;
    margin: 12rpx 0 28rpx;
    color: $color-text-secondary;
  }

  &__action {
    width: 100%;
    margin-top: 28rpx;
  }
}
</style>
