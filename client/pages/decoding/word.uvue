<template>
  <view class="page">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <text class="page-title centered">{{ pageData.title }}</text>
    <TipCard :text="pageData.tip" />
    <SegmentedWord
      :parts="pageData.parts"
      :ipa-segments="pageData.ipaSegments"
      :hint="pageData.hint"
    />
    <text class="section-title">字母与发音</text>
    <PronunciationMappings :items="pageData.mappings" />
    <StepActions :current="pageData.current" :total="pageData.total" @change="loadStep" />
  </view>
</template>
<script lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
import SegmentedWord from '../../components/SegmentedWord/index.uvue'
import PronunciationMappings from '../../components/PronunciationMappings/index.uvue'
export default {
  components: { LessonProgress, TipCard, StepActions, SegmentedWord, PronunciationMappings },
  data() {
    return {
      pageData: {
        id: 'word-decoding-component',
        current: 5,
        total: 12,
        title: '根据字母组合推测读音',
        tip: '非重读音节中的 o 常弱读为 /ə/',
        word: 'component',
        ipa: '/kəmˈpəʊnənt/',
        ipaSegments: [{ text: '/kəmˈpəʊnənt/', tone: 'muted' }],
        hint: '拖动分隔符调整拆分',
        audioUrl: '',
        parts: [
          { text: 'com', emphasized: false },
          { text: 'po', emphasized: true },
          { text: 'nent', emphasized: false },
        ],
        mappings: [
          { part: 'com', segments: [{ text: '/kəm/', tone: 'normal' }], tip: '辅音 + o 弱读 /ə/' },
          { part: 'po', segments: [{ text: '/pəʊ/', tone: 'stress' }], tip: '开音节 o 发 /əʊ/' },
          { part: 'nent', segments: [{ text: '/nənt/', tone: 'normal' }], tip: '结尾 t 不发音' },
        ],
      },
    }
  },
  methods: {
    loadStep(target: number) {
      if (target < this.pageData.current) uni.navigateBack()
    },
  },
}
</script>
