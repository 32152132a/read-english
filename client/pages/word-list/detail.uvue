<template>
  <view class="page word-library-detail">
    <text class="page-title">{{ pageData.title }}</text>
    <text class="word-library-detail__description">{{ pageData.description }}</text>
    <ExampleWordList :items="pageData.words" />
    <button class="primary-button word-library-detail__action" @click="startLearning">
      去学习
    </button>
    <DebugPageNav />
  </view>
</template>

<script setup lang="uts">
import ExampleWordList from '../../components/ExampleWordList/index.uvue'

const libraryId = ref('basic')
const pageData = reactive({
  title: '基础拼读词库',
  description: '先查看词库内容，再进入拆读练习。',
  words: [
    {
      word: 'component',
      segments: [{ text: '/kəmˈpəʊnənt/', tone: 'muted' }],
      zh: '组件',
      audioUrl: '',
    },
    {
      word: 'developer',
      segments: [{ text: '/dɪˈveləpə/', tone: 'muted' }],
      zh: '开发者',
      audioUrl: '',
    },
    {
      word: 'interface',
      segments: [{ text: '/ˈɪntəfeɪs/', tone: 'muted' }],
      zh: '接口',
      audioUrl: '',
    },
  ],
})

onLoad((options) => {
  const id = options['id']
  if (id != null) libraryId.value = id
})

function startLearning() {
  uni.navigateTo({ url: '/pages/decoding/word?libraryId=' + libraryId.value })
}
</script>

<style lang="scss">
@import '../../uni.scss';

.word-library-detail {
  &__description {
    display: block;
    margin: 12rpx 0 28rpx;
    color: $color-text-secondary;
  }

  &__action {
    width: 100%;
    margin-top: 28rpx;
  }
}
</style>
