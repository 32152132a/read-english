<template>
  <image
    class="app-icon"
    :src="iconSource"
    :style="{ width: size + 'rpx', height: size + 'rpx' }"
    mode="aspectFit"
    :aria-label="label"
  />
</template>

<script lang="uts">
const iconNames = [
  'chevron-left',
  'search',
  'play',
  'volume-2',
  'clock-3',
  'mic',
  'house',
  'user-round',
  'book-open',
  'headphones',
  'audio-waveform',
  'lightbulb',
  'circle-check',
  'lock-keyhole',
]

export default {
  props: {
    name: { type: String, required: true },
    size: { type: Number, default: 48 },
    active: { type: Boolean, default: false },
    tone: { type: String, default: 'default' },
    label: { type: String, default: '' },
  },
  computed: {
    iconSource(): string {
      const iconName = iconNames.includes(this.name) ? this.name : 'circle-check'
      if (this.active && ['house', 'user-round'].includes(iconName)) {
        return '/static/icons/' + iconName + '-active.svg'
      }
      if (
        this.tone === 'dark' &&
        ['book-open', 'headphones', 'audio-waveform'].includes(iconName)
      ) {
        return '/static/icons/' + iconName + '-dark.svg'
      }
      return '/static/icons/' + iconName + '.svg'
    },
  },
}
</script>

<style lang="scss">
.app-icon {
  display: block;
  flex-shrink: 0;
}
</style>
