<template>
  <view class="page phoneme-quiz">
    <RequestState v-if="unit == null" :error="error" @retry="loadSession" />
    <template v-else>
      <LessonProgress :current="current" :total="total" />
      <text class="page-title">{{ unit!.content!.title }}</text>
      <text class="muted phoneme-quiz__description">{{ unit!.content!.description }}</text>
      <ListeningPrompt v-if="audios.length > 0" :audios="audios" />
      <TipCard v-else text="请先根据题目中的音标说明完成练习。" />
      <text class="section-title">请选择</text>
      <ChoiceGroup
        :key="unit!.id"
        :options="options"
        :initial-value="selected"
        :disabled="submitting"
        :correct-value="answer?.correctOptionId ?? ''"
        @change="selectAnswer"
      />
      <TipCard v-if="answer != null" :text="answer!.explanation" />
      <button
        class="primary-button phoneme-quiz__confirm"
        :disabled="selected.length === 0 || submitting"
        @click="confirm"
      >
        {{ answer == null ? '确认答案' : current < total ? '下一题' : '完成本阶段' }}
      </button>
    </template>
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import RequestState from '../../components/RequestState/index.uvue'
import LessonProgress from '../../components/LessonProgress/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import ListeningPrompt from '../../components/ListeningPrompt/index.uvue'
import ChoiceGroup from '../../components/ChoiceGroup/index.uvue'
import { useLearningSession } from '../../src/composables/use-learning-session.uts'
import { useQuizAnswer } from '../../src/composables/use-quiz-answer.uts'
import type { QuizContent } from '../../src/config/api-types.uts'

const { session, unit, current, total, error, loadSession, loadStep, completeCurrentStage } =
  useLearningSession<QuizContent>('phoneme-quiz')
const { selected, answer, submitting, submitAnswer } = useQuizAnswer(
  () => session.value?.sessionId ?? '',
  () => unit.value?.content.questionId ?? ''
)
const options = computed(() =>
  (unit.value?.content.options ?? []).map((item) => ({
    label: item.id,
    text: item.label,
    value: item.id,
  }))
)
const audios = computed(() =>
  (unit.value?.content.audioUrls ?? []).map((url, index) => ({
    id: String(index),
    text: '点击播放',
    url,
  }))
)

function selectAnswer(value: string) {
  selected.value = value
}

async function confirm() {
  if (answer.value == null) {
    await submitAnswer(selected.value)
    return
  }
  if (current.value < total.value) await loadStep(current.value + 1)
  else await completeCurrentStage()
}
</script>
<style lang="scss">
@import '../../uni.scss';

.phoneme-quiz {
  &__category {
    display: block;
    margin-top: 36rpx;
  }

  &__description {
    display: block;
    margin-top: 10rpx;
    margin-bottom: 10rpx;
  }

  &__confirm {
    width: 100%;
    margin-top: 28rpx;

    &.is-disabled {
      opacity: 0.45;
    }
  }
}
</style>
