<template>
  <view class="stage-progress" :class="variant === 'path' ? 'stage-progress--path' : ''">
    <view v-if="variant === 'path'" class="stage-progress__track" />
    <view v-for="(step, index) in steps" :key="step.code" class="stage-progress__item">
      <text class="stage-progress__number" :class="step.state === 'active' ? 'is-active' : ''">
        {{ step.state === 'completed' ? '✓' : index + 1 }}
      </text>
      <text class="stage-progress__label" :class="step.state === 'active' ? 'is-active' : ''">
        {{ step.name }}
      </text>
    </view>
  </view>
</template>

<script lang="uts">
export default {
  props: {
    steps: { type: Array, required: true },
    variant: { type: String, default: 'default' },
  },
}
</script>

