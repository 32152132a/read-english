<template>
  <view class="phoneme-grid">
    <view
      v-for="item in items"
      :key="item.id"
      class="phoneme-grid__card"
      @click="$emit('select', item.id)"
    >
      <text class="phoneme-grid__status" :class="item.done ? 'is-done' : ''">
        {{ item.done ? '✓' : '·' }}
      </text>
      <PhonemeDisplay :segments="item.segments" />
      <text>{{ item.word }}</text>
      <text class="phoneme-grid__meaning">{{ item.zh }}</text>
    </view>
  </view>
</template>

<script lang="uts">
import PhonemeDisplay from '../PhonemeDisplay/index.uvue'

export default {
  components: { PhonemeDisplay },
  props: {
    items: { type: Array, required: true },
  },
  emits: ['select'],
}
</script>

