<template>
  <view class="lesson-progress">
    <text class="lesson-progress__label">{{ label }} {{ current }} / {{ total }}</text>
    <view class="lesson-progress__track">
      <view class="lesson-progress__value" :style="{ width: progressPercent + '%' }"></view>
    </view>
  </view>
</template>

<script lang="uts">
export default {
  props: {
    current: { type: Number, required: true },
    total: { type: Number, required: true },
    label: { type: String, default: '学习进度' },
  },
  computed: {
    progressPercent(): number {
      if (this.total <= 0) return 0

      return Math.min(Math.max((this.current / this.total) * 100, 0), 100)
    },
  },
}
</script>

<style lang="scss">
@import '../../uni.scss';

.lesson-progress {
  padding: 24rpx 0 16rpx;

  &__label {
    display: block;
    margin-bottom: 18rpx;
    color: $color-text-secondary;
    font-size: 25rpx;
    line-height: 36rpx;
  }

  &__track {
    height: 7rpx;
    border-radius: 8rpx;
    background-color: $color-border;
    overflow: hidden;
  }

  &__value {
    height: 100%;
    border-radius: inherit;
    background-color: $color-primary;
  }
}
</style>
