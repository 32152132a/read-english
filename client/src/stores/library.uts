import { defineStore } from 'pinia'
import { request } from '../services/http.uts'
import type { LibrarySummary } from '../config/api-types.uts'
import type { WordListCardItem, SystemLibraryOption } from '../config/types.uts'

function toLibraryCard(library: LibrarySummary): WordListCardItem {
  return {
    id: library.id,
    kindLabel:
      library.type === 'BASE'
        ? '基础词库'
        : library.type === 'AI_CUSTOM'
          ? 'AI 已解析'
          : '系统词库',
    icon: library.type === 'AI_CUSTOM' ? 'AI' : 'ABC',
    tone: library.type === 'AI_CUSTOM' ? 'purple' : 'blue',
    title: library.name,
    description: library.description,
    completed: library.learnedCount,
    total: library.wordCount,
    removable: library.removable,
  }
}

export const useLibraryStore = defineStore('library', () => {
  const ownedLibraries = ref<WordListCardItem[]>([])
  const availableLibraries = ref<SystemLibraryOption[]>([])

  async function loadOwned() {
    const result = await request<{ items: LibrarySummary[] }>({ url: '/word-libraries/mine' })
    ownedLibraries.value = result.items.map(toLibraryCard)
  }

  async function loadAvailable() {
    const result = await request<{ items: LibrarySummary[] }>({ url: '/word-libraries/available' })
    availableLibraries.value = result.items.map(toLibraryCard)
  }

  async function addLibraries(ids: string[]) {
    return await request<{ addedLibraryIds: string[] }>({
      url: '/word-libraries/mine',
      method: 'POST',
      data: { libraryIds: ids },
    })
  }

  async function removeLibrary(id: string) {
    await request({ url: '/word-libraries/mine/' + encodeURIComponent(id), method: 'DELETE' })
    await loadOwned()
  }

  return {
    ownedLibraries,
    availableLibraries,
    loadOwned,
    loadAvailable,
    addLibraries,
    removeLibrary,
  }
})
