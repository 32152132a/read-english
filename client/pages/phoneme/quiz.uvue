<template>
  <view class="page">
    <LessonProgress :current="2" :total="6" />
    <text class="muted kicker">短元音练习</text>
    <text class="page-title">你听到的是哪个音？</text>
    <text class="muted desc">先听发音，再选择对应的音标</text>
    <TipCard text="注意声音是否短促，以及嘴巴张开的程度" />
    <view class="card audio-card">
      <PlayButton text="点击播放" />
      <text class="again">↻　再听一次</text>
      <text class="muted">可以反复播放</text>
    </view>
    <text class="section-title">请选择</text>
    <view class="options">
      <view
        v-for="(item, index) in options"
        :key="item"
        class="option"
        :class="selected === index ? 'selected' : ''"
        @click="selected = index"
      >
        <text class="letter">{{ letters[index] }}</text>
        <text class="option-ipa">{{ item }}</text>
      </view>
    </view>
    <button class="primary-button confirm" @click="confirm">确认答案</button>
  </view>
</template>
<script lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import PlayButton from '../../components/PlayButton/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
export default {
  components: { LessonProgress, PlayButton, TipCard },
  data() {
    return {
      options: ['/ɪ/', '/iː/', '/e/', '/æ/'],
      letters: ['A', 'B', 'C', 'D'],
      selected: 3,
    }
  },
  methods: {
    confirm() {
      uni.navigateTo({ url: '/pages/phoneme/overview' })
    },
  },
}
</script>
