<template>
  <view class="phoneme-display" :class="'phoneme-display--' + displaySize">
    <text
      v-for="(segment, index) in segments"
      :key="index"
      class="phoneme-display__segment"
      :class="'is-' + segment.tone"
    >
      {{ segment.text }}
    </text>
  </view>
</template>

<script setup lang="uts">
import type { PhonemeDisplayProps } from '../../src/config/types.uts'

const props = withDefaults(defineProps<PhonemeDisplayProps>(), { size: 'default' })
const displaySize = computed((): string =>
  ['mini', 'large', 'hero'].includes(props.size) ? props.size : 'default'
)
</script>

