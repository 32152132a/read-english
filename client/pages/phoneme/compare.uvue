<template><view class="page"><LessonProgress :current="3" :total="20"/><text class="label">短元音对比</text><text class="page-title">区分 /ɪ/ 和 /iː/</text><text class="muted intro">一个短促放松，一个稍长并向两侧展开</text><TipCard text="/ɪ/ 短而放松，/iː/ 像微笑一样向两侧拉开。"/><view class="compare-grid"><view v-for="item in sounds" :key="item.ipa" class="sound-card" :class="item.green?'green-card':''"><text class="big-ipa">{{item.ipa}}</text><text class="sound-name">{{item.name}}</text><view class="row listen-row"><PlayButton text="听发音"/></view><text class="mouth-line">⌣</text><text class="tip-line">{{item.tip}}</text><text class="examples">{{item.examples}}</text></view></view><text class="section-title">听一听它们的区别</text><view class="card pair"><PlayButton size="mini"/><view><text class="pair-word">ship</text><text class="muted">/ʃɪp/</text></view><text class="swap">⇄</text><view><text class="pair-word">sheep</text><text class="muted">/ʃiːp/</text></view><PlayButton size="mini"/></view><StepActions :current="3" :total="20" @change="loadStep"/></view></template>
<script lang="uts">import LessonProgress from '../../components/LessonProgress/index.uvue';import PlayButton from '../../components/PlayButton/index.uvue';import TipCard from '../../components/TipCard/index.uvue';import StepActions from '../../components/StepActions/index.uvue';export default{components:{LessonProgress,PlayButton,TipCard,StepActions},data(){return{sounds:[{ipa:'/ɪ/',name:'短促的「衣」',tip:'嘴角放松，快速收音',examples:'ship · sit · live',green:false},{ipa:'/iː/',name:'拉长的「衣」',tip:'嘴角向两侧，声音延长',examples:'sheep · seat · leave',green:true}]}},methods:{loadStep(target:number){if(target<3){uni.navigateBack();return}this.goQuiz()},goQuiz(){uni.navigateTo({url:'/pages/phoneme/quiz'})}}}</script>
<style lang="scss">@import '../../uni.scss';.label{display:block;margin-top:40rpx;color:$color-text-secondary;font-size:26rpx}.intro{display:block;margin-top:10rpx;font-size:25rpx}.compare-grid{display:flex;gap:24rpx;margin-top:34rpx}.sound-card{flex:1;padding:28rpx 18rpx;border:2rpx solid #91a8ff;border-radius:18rpx;text-align:center;color:$color-primary}.green-card{border-color:#9edbd5;color:#12aa9d}.big-ipa,.sound-name,.tip-line,.examples{display:block}.big-ipa{font-size:72rpx}.sound-name{font-size:26rpx;font-weight:600}.listen-row{justify-content:center;gap:14rpx;margin:22rpx 0}.mouth-line{font-size:80rpx}.tip-line{color:$color-text-primary;font-size:22rpx}.examples{margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #dce3ee;color:$color-text-primary;font-size:22rpx}.pair{display:flex;align-items:center;justify-content:space-between}.pair-word{display:block;font-size:30rpx;font-weight:700}.swap{font-size:38rpx;color:$color-text-secondary}</style>
