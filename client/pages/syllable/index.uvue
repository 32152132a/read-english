<template>
  <view class="page">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <view class="center">
      <text class="page-title">{{ pageData.title }}</text>
      <text class="muted">{{ pageData.description }}</text>
    </view>
    <TipCard :title="pageData.tipTitle" :text="pageData.tip" />
    <SegmentedWord
      :word="pageData.example.word"
      :ipa-segments="pageData.example.ipaSegments"
      :parts="pageData.example.chunks"
      separator="·"
    />
    <InfoSteps title="怎么判断" :items="pageData.rules" />
    <view class="card question">
      <text>{{ pageData.question.text }}</text>
      <ChoiceGroup
        :options="pageData.question.options"
        :initial-value="pageData.question.answer"
        @change="selectAnswer"
      />
    </view>
    <StepActions :current="pageData.current" :total="pageData.total" @change="loadStep" />
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
import SegmentedWord from '../../components/SegmentedWord/index.uvue'
import InfoSteps from '../../components/InfoSteps/index.uvue'
import ChoiceGroup from '../../components/ChoiceGroup/index.uvue'
const pageData = reactive({
  id: 'syllable-basic',
  current: 2,
  total: 3,
  title: '一个元音音素，一个音节',
  description: '每个音节都只有一个元音音素作为核心。',
  tipTitle: '记忆小贴士',
  tip: '看元音音素，不是数元音字母。',
  example: {
    word: 'computer',
    ipaSegments: [{ text: '/kəmˈpjuːtər/', tone: 'muted' }],
    chunks: [
      { text: 'kəm', emphasized: false },
      { text: 'pjuː', emphasized: true },
      { text: 'tər', emphasized: false },
    ],
  },
  rules: [
    { title: '找元音音素', text: '找出单词中的元音音素。' },
    { title: '数出元音数量', text: '元音音素的数量 = 音节的数量。' },
    { title: '按发音节奏拆分', text: '每个元音音素为一个音节的核心。' },
  ],
  question: {
    text: 'computer 有几个音节？',
    options: [
      { value: '2', label: '', text: '2' },
      { value: '3', label: '', text: '3' },
      { value: '4', label: '', text: '4' },
    ],
    answer: '3',
  },
})
const stepList = [
  {
    title: '先找到元音音素',
    description: '元音音素是划分音节的核心线索。',
    tip: '先听声音，再看音标中的元音。',
  },
  {
    title: '一个元音音素，一个音节',
    description: '每个音节都只有一个元音音素作为核心。',
    tip: '看元音音素，不是数元音字母。',
  },
  {
    title: '按发音节奏完成拆分',
    description: '重读和弱读会形成清楚的音节节奏。',
    tip: '慢速朗读，更容易听出音节边界。',
  },
]

function selectAnswer(value: string) {
  pageData.question.answer = value
}

function loadStep(target: number) {
  const step = stepList[target - 1]
  if (step == null) return

  pageData.current = target
  pageData.title = step.title
  pageData.description = step.description
  pageData.tip = step.tip
}
</script>
<style lang="scss">
@import '../../uni.scss';
.center {
  text-align: center;
  margin: 42rpx 0 36rpx;
}
.center .muted {
  display: block;
  margin-top: 12rpx;
}
.question {
  margin-top: 28rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}
.question .choice-group {
  margin-top: 24rpx;
}
</style>
