<template>
  <view class="recording-panel">
    <view class="recording-panel__control">
      <view v-if="recording" class="recording-panel__ripples">
        <view v-for="index in 3" :key="index" class="recording-panel__ripple" />
      </view>
      <view
        class="recording-panel__button"
        :class="recording ? 'is-recording' : ''"
        @click="toggleRecording"
      >
        <AppIcon name="mic-white" :size="62" />
      </view>
    </view>
    <text class="recording-panel__title">{{ recording ? activeText : title }}</text>
    <text class="recording-panel__description">
      {{ recording ? activeDescription : description }}
    </text>
  </view>
</template>

<script setup lang="uts">
import type { RecordingPanelProps } from '../../src/config/types.uts'

withDefaults(defineProps<RecordingPanelProps>(), {
  title: '点击开始跟读',
  activeText: '点击结束录音',
  description: '',
  activeDescription: '',
})
const emit = defineEmits(['start', 'finish'])
const recording = ref(false)

function toggleRecording() {
  recording.value = !recording.value
  emit(recording.value ? 'start' : 'finish')
}
</script>

<style lang="scss">
@import '../../uni.scss';

.recording-panel {
  min-height: 390rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-content: center;
  justify-items: center;
  gap: 24rpx;

  &__control {
    display: grid;
    grid-template-columns: 320rpx;
    grid-template-rows: 320rpx;
    place-items: center;
  }

  &__ripples {
    display: grid;
    grid-template-columns: 320rpx;
    grid-template-rows: 320rpx;
    place-items: center;
  }

  &__ripples,
  &__button {
    grid-column: 1;
    grid-row: 1;
  }

  &__button {
    width: 146rpx;
    height: 146rpx;
    box-sizing: border-box;
    border: 18rpx solid #e7ecff;
    border-radius: 50%;
    background: linear-gradient(145deg, #6276ff, #2648f5);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 14rpx 34rpx rgba(54, 82, 230, 0.24);

    &.is-recording {
      border-color: #ffe0e2;
      background: linear-gradient(145deg, #ff777d, #e4474f);
    }
  }

  &__ripple {
    grid-column: 1;
    grid-row: 1;
    width: 146rpx;
    height: 146rpx;
    box-sizing: border-box;
    border-radius: 50%;
    border: 4rpx solid rgba(228, 71, 79, 0.5);
    animation: recording-ripple 1.8s ease-out infinite;

    &:nth-child(2) {
      animation-delay: 0.6s;
    }

    &:nth-child(3) {
      animation-delay: 1.2s;
    }
  }

  &__title {
    color: $color-primary;
    font-size: 32rpx;
  }

  &__description {
    color: $color-text-secondary;
  }
}

@keyframes recording-ripple {
  from {
    opacity: 0.65;
    transform: scale(1);
  }
  to {
    opacity: 0;
    transform: scale(2);
  }
}
</style>
