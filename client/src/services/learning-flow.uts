import { request } from './http.uts'
import type { LearningFlowNode } from '../config/types.uts'
import type { FlowConfig, FlowTemplate, CompleteStageResponse } from '../config/api-types.uts'

// 仅供编辑器恢复默认使用；活动流程和模板由后端返回。
export const DEFAULT_LEARNING_FLOW: LearningFlowNode[] = [
  'phoneme',
  'phoneme-compare',
  'phoneme-quiz',
  'syllable',
  'ipa-decoding',
  'word-decoding',
  'evaluation',
].map((templateCode) => ({ id: 'default-' + templateCode, templateCode }))

export function getLearningFlow() {
  return request<FlowConfig>({ url: '/learning-flow', showError: false })
}

export function getLearningFlowTemplates() {
  return request<FlowTemplate[]>({ url: '/learning-flow/templates', showError: false })
}

export function saveLearningFlow(nodes: LearningFlowNode[], version: number) {
  return request<FlowConfig>({
    url: '/learning-flow',
    method: 'PUT',
    data: {
      version,
      nodes: nodes.map((node) => ({ clientNodeId: node.id, templateCode: node.templateCode })),
    },
  })
}

export function completeLearningStage(
  flowNodeId: string,
  lastUnitId: string,
  idempotencyKey: string
) {
  return request<CompleteStageResponse>({
    url: '/learning-flow/current/complete',
    method: 'POST',
    header: { 'Idempotency-Key': idempotencyKey },
    data: { flowNodeId, lastUnitId },
  })
}
