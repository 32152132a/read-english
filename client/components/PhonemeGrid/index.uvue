<template>
  <view class="phoneme-grid">
    <view v-for="item in items" :key="item.id" class="phoneme-grid__item">
      <text class="phoneme-grid__phoneme" @click="$emit('select', item.id)">
        {{ item.segments[0].text }}
      </text>
      <PlayButton
        :src="audioFor(item)"
        :word="item.fallbackWord ?? ''"
        :accent="accent"
        size="micro"
        icon="volume"
      />
    </view>
  </view>
</template>

<script setup lang="uts">
import PlayButton from '../PlayButton/index.uvue'
import type { PhonemeGridItem, PhonemeGridProps } from '../../src/config/types.uts'
import { getAccentPreference } from '../../src/services/accent.uts'

defineProps<PhonemeGridProps>()
defineEmits(['select'])
const accent = ref(getAccentPreference())

function audioFor(item: PhonemeGridItem): string {
  const preferred = accent.value === 'GB' ? item.audioGbUrl : item.audioUsUrl
  return preferred?.length ? preferred : (item.audioUrl ?? '')
}

onShow(() => {
  accent.value = getAccentPreference()
})
</script>

<style lang="scss">
@import '../../uni.scss';

.phoneme-grid {
  width: 100%;
  padding: 2rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 2rpx;
  background-color: $color-border;

  &__item {
    min-width: 0;
    padding: 18rpx 10rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6rpx;
    background-color: $color-background;
  }

  &__phoneme {
    color: $color-primary;
    font-size: 36rpx;
    line-height: 40rpx;
  }
}
</style>
