<template><view class="page"><LessonProgress current="2" total="8" :percent="25"/><view class="center"><text class="page-title">一个元音音素，一个音节</text><text class="muted">每个音节都只有一个元音音素作为核心。</text></view><view class="card word-card"><text class="word">computer</text><text class="ipa">/kəmˈpjuːtər/</text><view class="chunks"><text class="blue">kəm</text><text> · </text><text class="green">pjuː</text><text> · </text><text class="purple">tər</text></view></view><view class="card rules"><text class="section-title first">怎么判断</text><view v-for="(rule,index) in rules" :key="rule.title" class="rule"><text class="number">{{index+1}}</text><view><text class="rule-title">{{rule.title}}</text><text class="muted rule-text">{{rule.text}}</text></view></view></view><view class="card question"><text>computer 有几个音节？</text><view class="answers"><text>2</text><text class="chosen">3</text><text>4</text></view></view><TipCard title="记忆小贴士" text="看元音音素，不是数元音字母。"/><StepActions @next="next"/></view></template>
<script lang="uts">import LessonProgress from '../../components/LessonProgress/index.uvue';import TipCard from '../../components/TipCard/index.uvue';import StepActions from '../../components/StepActions/index.uvue';export default{components:{LessonProgress,TipCard,StepActions},data(){return{rules:[{title:'找元音音素',text:'找出单词中的元音音素。'},{title:'数出元音数量',text:'元音音素的数量 = 音节的数量。'},{title:'按发音节奏拆分',text:'每个元音音素为一个音节的核心。'}]}},methods:{next(){uni.navigateTo({url:'/pages/decoding/ipa'})}}}</script>
<style lang="scss">@import '../../uni.scss';.center{text-align:center;margin:42rpx 0 36rpx}.center .muted{display:block;margin-top:12rpx}.word-card{text-align:center}.word{display:block;font-size:58rpx;font-weight:700}.ipa{display:block;margin:18rpx;color:$color-text-secondary;font-size:34rpx}.chunks{font-size:42rpx}.blue{color:#1451ff}.green{color:#14a76c}.purple{color:#7c3cff}.rules{margin-top:28rpx}.first{margin-top:0}.rule{display:flex;gap:20rpx;margin:24rpx 0}.number{width:46rpx;height:46rpx;border-radius:50%;background:$color-primary;color:#fff;text-align:center;line-height:46rpx}.rule-title,.rule-text{display:block}.rule-title{font-weight:600}.rule-text{margin-top:6rpx}.question{margin-top:28rpx;text-align:center;font-size:28rpx;font-weight:600}.answers{display:flex;gap:18rpx;margin-top:24rpx}.answers text{flex:1;padding:18rpx;border:1rpx solid $color-border;border-radius:10rpx}.answers .chosen{border-color:$color-primary;color:$color-primary;background:#f3f6ff}</style>
