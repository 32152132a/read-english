<template>
  <view class="library-study">
    <RequestState v-if="session == null" :error="error" @retry="load" />
    <template v-else-if="active">
      <text>词库练习 {{ index + 1 }} / {{ session!.items.length }}</text>
      <ContentPreview
        :key="active!.wordId"
        :config="active"
        :answers="answers"
        :busy="busy"
        @answer="answer"
      />
      <button class="primary-button" :disabled="busy" @click="complete">完成此词，继续学习</button>
    </template>
    <template v-else>
      <text>本次词库学习已完成</text>
      <button class="primary-button" @click="back">返回词库</button>
    </template>
  </view>
</template>
<script setup lang="uts">
import { request, showRequestError } from '../../src/services/http.uts'
import type { ContentStudy } from '../../src/config/content-types.uts'
import type { AnswerResponse } from '../../src/config/api-types.uts'
import RequestState from '../RequestState/index.uvue'
import ContentPreview from '../ContentPreview/index.uvue'
const props = defineProps<{ libraryId: string }>()
const session = ref<ContentStudy | null>(null),
  error = ref(''),
  index = ref(0),
  busy = ref(false)
const answers = ref<Record<string, AnswerResponse>>({})
const active = computed(() => session.value?.items[index.value] ?? null)
async function load() {
  error.value = ''
  try {
    session.value = await request<ContentStudy>({
      url: '/word-libraries/' + props.libraryId + '/study',
      method: 'POST',
      showError: false,
    })
    index.value = 0
    answers.value = {}
  } catch (e) {
    error.value = (e as Error).message
  }
}
async function answer(questionId: string, selectedOptionId: string) {
  if (busy.value || !session.value || !active.value) return
  busy.value = true
  try {
    const response = await request<AnswerResponse>({
      url: '/content-study/' + session.value.sessionId + '/answers',
      method: 'POST',
      data: { questionId: active.value.wordId + ':' + questionId, selectedOptionId },
    })
    answers.value = { ...answers.value, [questionId]: response }
  } catch (e) {
    showRequestError(e)
  } finally {
    busy.value = false
  }
}
async function complete() {
  if (busy.value || !session.value || !active.value) return
  busy.value = true
  try {
    await request({
      url:
        '/content-study/' + session.value.sessionId + '/words/' + active.value.wordId + '/complete',
      method: 'POST',
    })
    index.value++
    answers.value = {}
  } catch (e) {
    showRequestError(e)
  } finally {
    busy.value = false
  }
}
function back() {
  uni.navigateBack()
}
watch(() => props.libraryId, load, { immediate: true })
</script>
<style lang="scss">
.library-study {
  width: 100%;
  box-sizing: border-box;
  grid-template-columns: minmax(0, 1fr);
  display: grid;
  gap: 28rpx;
}
</style>
