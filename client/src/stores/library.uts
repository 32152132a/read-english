import { defineStore } from 'pinia'
import type { SystemLibraryOption, WordListCardItem } from '../config/types.uts'

const INITIAL_LIBRARY_OPTIONS: SystemLibraryOption[] = [
  {
    id: 'frontend',
    icon: '</>',
    tone: 'blue',
    kindLabel: '系统词库',
    title: '前端开发',
    description: 'HTML、CSS、JavaScript 常用词汇',
    total: 286,
  },
  {
    id: 'node',
    icon: 'JS',
    tone: 'green',
    kindLabel: '系统词库',
    title: 'Node.js 与后端',
    description: 'Node.js、数据库和服务端词汇',
    total: 180,
  },
  {
    id: 'ai',
    icon: 'AI',
    tone: 'purple',
    kindLabel: '系统词库',
    title: 'AI 与大模型',
    description: '机器学习、深度学习和大模型词汇',
    total: 168,
  },
  {
    id: 'custom-product',
    icon: 'AI',
    tone: 'purple',
    kindLabel: 'AI 已解析',
    title: '产品经理常用词',
    description: '根据 12 个输入单词生成，可选择添加到我的词库',
    total: 12,
  },
]

export const useLibraryStore = defineStore('library', () => {
  const libraryOptions = ref<SystemLibraryOption[]>(INITIAL_LIBRARY_OPTIONS)
  const ownedLibraries = ref<WordListCardItem[]>([
    {
      id: 'basic',
      icon: 'ABC',
      tone: 'blue',
      kindLabel: '基础词库',
      title: '基础拼读词库',
      description: '覆盖常见音标、音节和基础拼读规则',
      completed: 24,
      total: 120,
      removable: false,
    },
  ])
  const availableLibraries = computed((): SystemLibraryOption[] =>
    libraryOptions.value.filter(
      (item) => !ownedLibraries.value.some((owned) => owned.id === item.id)
    )
  )

  function addLibraries(ids: string[]) {
    availableLibraries.value
      .filter((item) => ids.includes(item.id))
      .forEach((item) => {
        ownedLibraries.value.push({ ...item, completed: 0, removable: true })
      })
  }
  function createCustomLibrary(name: string, words: string[]) {
    libraryOptions.value.push({
      id: 'custom-' + Date.now(),
      icon: 'AI',
      tone: 'purple',
      kindLabel: 'AI 已解析',
      title: name,
      description: '根据手动输入的单词生成，可选择添加到我的词库',
      total: words.length,
    })
  }
  function removeLibrary(id: string) {
    ownedLibraries.value = ownedLibraries.value.filter(
      (item) => item.id === 'basic' || item.id !== id
    )
  }
  return { ownedLibraries, availableLibraries, addLibraries, createCustomLibrary, removeLibrary }
})
