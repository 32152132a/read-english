import { useLearningFlowStore } from '../stores/learning-flow.uts'

export function useLearningFlowNavigation() {
  const learningFlowStore = useLearningFlowStore()
  let completing = false

  async function completeCurrentStage() {
    if (completing) return
    completing = true

    if (learningFlowStore.reviewMode) {
      learningFlowStore.finishReview()
      completing = false
      uni.navigateBack()
      return
    }

    let nextRoute = ''
    try {
      nextRoute = await learningFlowStore.completeCurrentStage()
    } catch (_error) {
      uni.showToast({ title: '学习进度保存失败，请重试', icon: 'none' })
      return
    } finally {
      completing = false
    }
    if (nextRoute.length > 0) {
      uni.redirectTo({ url: nextRoute })
      return
    }

    uni.showModal({
      title: '学习完成',
      content: '你已经完成本轮学习流程。',
      showCancel: false,
      confirmText: '返回首页',
      success: () => uni.reLaunch({ url: '/pages/home/index' }),
    })
  }

  return { completeCurrentStage }
}
