<template>
  <view class="error-page">
    <image
      class="error-page__illustration"
      src="/static/images/learning-access.svg"
      mode="aspectFit"
    />
    <text class="error-page__title">{{ title }}</text>
    <text class="error-page__description">{{ description }}</text>
    <button class="primary-button error-page__button" @click="goHome">返回首页</button>
  </view>
</template>

<script setup lang="uts">
const title = ref('当前页面无法访问')
const description = ref('这个学习入口无效或已经失效，请从首页重新进入。')

onLoad((options) => {
  if (options['code'] === 'FLOW_NODE_MISMATCH') {
    title.value = '学习入口已失效'
    description.value = '学习流程已经变化，请从首页重新进入当前任务。'
  }
})

function goHome() {
  uni.reLaunch({ url: '/pages/home/index' })
}
</script>

<style lang="scss">
@import '../../uni.scss';

.error-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 64rpx 40rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  place-content: center;
  justify-items: center;
  gap: 18rpx;
  text-align: center;

  &__illustration {
    width: 360rpx;
    height: 260rpx;
  }

  &__title {
    font-size: 36rpx;
    font-weight: 700;
  }

  &__description {
    max-width: 620rpx;
    color: $color-text-secondary;
    font-size: 25rpx;
    line-height: 1.7;
  }

  &__button {
    width: 260rpx;
    margin-top: 16rpx;
  }
}
</style>
