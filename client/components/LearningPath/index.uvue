<template>
  <view class="learning-path card">
    <view class="learning-path__head">
      <text class="learning-path__current">
        {{ currentStep == null ? '本轮学习已完成' : '当前：' + currentStep.name }}
      </text>
      <text class="learning-path__count">{{ progressCurrent }} / {{ steps.length }}</text>
    </view>
    <view class="learning-path__steps">
      <view
        v-for="(step, index) in steps"
        :key="step.code"
        class="learning-path__step-item"
        @click="selectStep(step)"
      >
        <text class="learning-path__number" :class="'is-' + step.state">{{ index + 1 }}</text>
        <text v-if="index < steps.length - 1 && (index + 1) % 4 !== 0" class="learning-path__arrow">
          ›
        </text>
        <view v-else class="learning-path__arrow-space" />
        <text class="learning-path__name" :class="'is-' + step.state">{{ step.name }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import type { LearningPathProps, StageItem } from '../../src/config/types.uts'

const props = defineProps<LearningPathProps>()
const emit = defineEmits(['select'])

const currentStep = computed(() => props.steps[props.currentIndex])
const progressCurrent = computed((): number => Math.min(props.currentIndex + 1, props.steps.length))

function selectStep(step: StageItem) {
  if (step.state !== 'completed') return
  emit('select', step.route)
}
</script>

<style lang="scss">
@import '../../uni.scss';

.learning-path {
  width: 100%;
  padding: 28rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 26rpx;

  &__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  &__current {
    font-weight: 600;
  }

  &__count {
    color: $color-text-secondary;
    font-size: 22rpx;
  }

  &__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: start;
    gap: 24rpx 12rpx;
  }

  &__step-item {
    width: 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rpx;
    grid-template-rows: 52rpx auto;
    row-gap: 10rpx;
  }

  &__arrow {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    color: $color-text-secondary;
    font-size: 34rpx;
  }

  &__arrow-space {
    grid-column: 2;
    grid-row: 1;
    width: 16rpx;
  }

  &__number {
    grid-column: 1;
    grid-row: 1;
    justify-self: center;
    width: 52rpx;
    height: 52rpx;
    border-radius: 50%;
    background-color: #eef1ff;
    color: $color-primary;
    text-align: center;
    line-height: 52rpx;

    &.is-active {
      background-color: $color-primary;
      color: #fff;
    }

    &.is-completed {
      background-color: #e8f8f2;
      color: #159a6b;
    }
  }

  &__name {
    grid-column: 1;
    grid-row: 2;
    justify-self: center;
    text-align: center;
    font-size: 23rpx;

    &.is-active {
      color: $color-primary;
      font-weight: 600;
    }

    &.is-pending {
      color: $color-text-secondary;
    }
  }
}
</style>
