import { completeLearningStage } from '../services/learning-flow.uts'
import { showRequestError } from '../services/http.uts'

export function useLearningFlowNavigation() {
  let completing = false

  async function completeCurrentStage(flowNodeId: string, lastUnitId: string, review: boolean) {
    if (completing) return
    if (review) {
      uni.navigateBack({ fail: () => uni.reLaunch({ url: '/pages/home/index' }) })
      return
    }
    if (flowNodeId.length === 0) return
    completing = true
    try {
      // 节点 ID 全局唯一，重试沿用幂等键，避免响应丢失时重复推进。
      const result = await completeLearningStage(flowNodeId, lastUnitId, 'complete-' + flowNodeId)
      if (result.nextNode != null) {
        uni.redirectTo({
          url: result.nextNode.route + '?flowNodeId=' + encodeURIComponent(result.nextNode.id),
        })
      } else {
        uni.showModal({
          title: '学习完成',
          content: '你已经完成本轮学习流程。',
          showCancel: false,
          confirmText: '返回首页',
          success: () => uni.reLaunch({ url: '/pages/home/index' }),
        })
      }
    } catch (error) {
      showRequestError(error)
    } finally {
      completing = false
    }
  }

  return { completeCurrentStage }
}
