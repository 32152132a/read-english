<template>
  <view class="page">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <text class="label">{{ pageData.category }}</text>
    <text class="page-title">{{ pageData.title }}</text>
    <text class="muted intro">{{ pageData.description }}</text>
    <TipCard :text="pageData.tip" />
    <PhonemeComparison :items="pageData.sounds" />
    <text class="section-title">{{ pageData.pairTitle }}</text>
    <WordPairPlayer :items="pageData.wordPair" />
    <StepActions :current="pageData.current" :total="pageData.total" @change="loadStep" />
    <DebugPageNav />
  </view>
</template>
<script lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
import PhonemeComparison from '../../components/PhonemeComparison/index.uvue'
import WordPairPlayer from '../../components/WordPairPlayer/index.uvue'
export default {
  components: { LessonProgress, TipCard, StepActions, PhonemeComparison, WordPairPlayer },
  data() {
    return {
      pageData: {
        id: 'short-vowel-comparison',
        current: 2,
        total: 3,
        category: '短元音对比',
        title: '区分 /ɪ/ 和 /iː/',
        description: '一个短促放松，一个稍长并向两侧展开',
        tip: '/ɪ/ 短而放松，/iː/ 像微笑一样向两侧拉开。',
        sounds: [
          {
            ipa: '/ɪ/',
            segments: [{ text: '/ɪ/', tone: 'primary' }],
            name: '短促的「衣」',
            tip: '嘴角放松，快速收音',
            examples: 'ship · sit · live',
            audioUrl: '',
            tone: 'primary',
          },
          {
            ipa: '/iː/',
            segments: [{ text: '/iː/', tone: 'primary' }],
            name: '拉长的「衣」',
            tip: '嘴角向两侧，声音延长',
            examples: 'sheep · seat · leave',
            audioUrl: '',
            tone: 'success',
          },
        ],
        pairTitle: '听一听它们的区别',
        wordPair: [
          {
            word: 'ship',
            ipa: '/ʃɪp/',
            segments: [{ text: '/ʃɪp/', tone: 'muted' }],
            audioUrl: '',
          },
          {
            word: 'sheep',
            ipa: '/ʃiːp/',
            segments: [{ text: '/ʃiːp/', tone: 'muted' }],
            audioUrl: '',
          },
        ],
      },
      stepList: [
        {
          pairTitle: '先听第一组单词',
          wordPair: [
            { word: 'ship', segments: [{ text: '/ʃɪp/', tone: 'muted' }], audioUrl: '' },
            { word: 'sheep', segments: [{ text: '/ʃiːp/', tone: 'muted' }], audioUrl: '' },
          ],
        },
        {
          pairTitle: '再听一组相似单词',
          wordPair: [
            { word: 'sit', segments: [{ text: '/sɪt/', tone: 'muted' }], audioUrl: '' },
            { word: 'seat', segments: [{ text: '/siːt/', tone: 'muted' }], audioUrl: '' },
          ],
        },
        {
          pairTitle: '最后听完整单词',
          wordPair: [
            { word: 'live', segments: [{ text: '/lɪv/', tone: 'muted' }], audioUrl: '' },
            { word: 'leave', segments: [{ text: '/liːv/', tone: 'muted' }], audioUrl: '' },
          ],
        },
      ],
    }
  },
  methods: {
    loadStep(target: number) {
      const step = this.stepList[target - 1]
      if (step == null) return

      this.pageData.current = target
      this.pageData.pairTitle = step.pairTitle
      this.pageData.wordPair = step.wordPair
    },
  },
}
</script>
<style lang="scss">
@import '../../uni.scss';
.label {
  display: block;
  margin-top: 40rpx;
  color: $color-text-secondary;
  font-size: 26rpx;
}
.intro {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
}
</style>
