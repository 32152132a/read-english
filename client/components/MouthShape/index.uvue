<template>
  <image
    class="mouth-shape"
    :src="imageSource"
    :style="{ width: shapeWidth + 'rpx', height: shapeHeight + 'rpx' }"
    mode="aspectFit"
  />
</template>

<script setup lang="uts">
import type { MouthShapeProps } from '../../src/config/types.uts'

const props = withDefaults(defineProps<MouthShapeProps>(), {
  type: 'open',
  size: 'medium',
  tone: 'primary',
})
const shapeType = computed((): string =>
  ['open', 'relaxed', 'smile'].includes(props.type) ? props.type : 'open'
)
const shapeTone = computed((): string => (props.tone === 'success' ? 'success' : 'primary'))
const shapeWidth = computed((): number => {
  if (props.size === 'mini') return 100
  if (props.size === 'large') return 300
  return 148
})
const shapeHeight = computed((): number => Math.round(shapeWidth.value * 0.7))
const imageSource = computed((): string => {
  if (shapeType.value === 'relaxed') {
    return shapeTone.value === 'success'
      ? '/static/images/mouth-relaxed-success.svg'
      : '/static/images/mouth-relaxed.svg'
  }
  if (shapeType.value === 'smile') {
    return shapeTone.value === 'success'
      ? '/static/images/mouth-smile.svg'
      : '/static/images/mouth-smile-primary.svg'
  }
  return shapeTone.value === 'success'
    ? '/static/images/mouth-open-success.svg'
    : '/static/images/mouth-open.svg'
})
</script>

<style lang="scss">
.mouth-shape {
  display: block;
}
</style>
