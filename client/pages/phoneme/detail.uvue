<template>
  <view class="page">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <text class="label">{{ pageData.category }}</text>
    <PhonemeDisplay :segments="pageData.segments" size="large" />
    <text class="description">{{ pageData.description }}</text>
    <TipCard :text="pageData.memoryTip" />
    <view class="listen">
      <PlayButton :src="pageData.audioUrl" text="听发音" />
      <text class="slow">◷ 慢速</text>
    </view>
    <PronunciationGuide :steps="pageData.mouthSteps" />
    <text class="section-title">放进单词里听</text>
    <ExampleWordList :items="pageData.examples" />
    <text class="compare" @click="goCompare">{{ pageData.comparisonText }}　›</text>
    <StepActions :current="pageData.current" :total="pageData.total" @change="loadStep" />
  </view>
</template>
<script lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import PlayButton from '../../components/PlayButton/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
import PhonemeDisplay from '../../components/PhonemeDisplay/index.uvue'
import PronunciationGuide from '../../components/PronunciationGuide/index.uvue'
import ExampleWordList from '../../components/ExampleWordList/index.uvue'
export default {
  components: {
    LessonProgress,
    PlayButton,
    TipCard,
    StepActions,
    PhonemeDisplay,
    PronunciationGuide,
    ExampleWordList,
  },
  data() {
    return {
      pageData: {
        id: 'phoneme-ae',
        current: 4,
        total: 20,
        category: '短元音',
        ipa: '/æ/',
        segments: [{ text: '/æ/', tone: 'primary' }],
        description: '接近「爱」，嘴巴张得更大',
        memoryTip: '像突然张嘴说「爱」，但声音更短、更扁。',
        audioUrl: '',
        slowAudioUrl: '',
        mouthSteps: ['嘴巴自然张大', '舌尖靠近下齿', '声音短促，不要拖长'],
        examples: [
          {
            word: 'cat',
            ipa: '/kæt/',
            segments: [{ text: '/kæt/', tone: 'muted' }],
            zh: '猫',
            audioUrl: '',
          },
          {
            word: 'map',
            ipa: '/mæp/',
            segments: [{ text: '/mæp/', tone: 'muted' }],
            zh: '地图',
            audioUrl: '',
          },
          {
            word: 'happy',
            ipa: "/'hæpi/",
            segments: [{ text: "/'hæpi/", tone: 'muted' }],
            zh: '开心的',
            audioUrl: '',
          },
        ],
        comparisonText: '容易和哪个音混淆？对比 /e/',
        comparisonRoute: '/pages/phoneme/compare',
      },
    }
  },
  methods: {
    loadStep(target: number) {
      if (target < this.pageData.current) {
        uni.navigateBack()
        return
      }
      this.goCompare()
    },
    goCompare() {
      uni.navigateTo({ url: this.pageData.comparisonRoute })
    },
  },
}
</script>
<style lang="scss">
@import '../../uni.scss';
.label {
  display: block;
  margin-top: 40rpx;
  color: $color-text-secondary;
  font-size: 27rpx;
}
.description {
  display: block;
  text-align: center;
  color: $color-text-secondary;
  font-size: 28rpx;
}
.listen {
  margin: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}
.slow {
  padding: 12rpx 18rpx;
  border: 1rpx solid $color-border;
  border-radius: 28rpx;
  color: $color-text-secondary;
}
.compare {
  display: block;
  margin: 24rpx 4rpx;
  color: $color-primary;
  font-size: 24rpx;
}
</style>
