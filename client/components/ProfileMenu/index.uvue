<template>
  <view class="profile-menu">
    <view
      v-for="item in items"
      :key="item.code"
      class="profile-menu__item"
      @click="selectItem(item)"
    >
      <AppIcon :name="item.iconName" :size="34" :label="item.label" />
      <text :class="item.danger == true ? 'is-danger' : ''">{{ item.label }}</text>
      <text v-if="item.value" class="profile-menu__value">{{ item.value }}</text>
      <text v-if="item.clickable != false" class="profile-menu__arrow">›</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import type { ProfileMenuItem, ProfileMenuProps } from '../../src/config/types.uts'

withDefaults(defineProps<ProfileMenuProps>(), {
  items: (): ProfileMenuItem[] => [],
})
const emit = defineEmits(['select'])

function selectItem(item: ProfileMenuItem) {
  if (item.clickable == false) return
  emit('select', item.code)
}
</script>

<style lang="scss">
@import '../../uni.scss';

.profile-menu {
  padding: 0 28rpx;
  border: 1rpx solid $color-border;
  border-radius: 18rpx;
  background: #fff;

  &__item {
    display: grid;
    grid-template-columns: 34rpx minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 12rpx;
    padding: 26rpx 6rpx;
    border-bottom: 1rpx solid $color-border;

    &:last-child {
      border-bottom: 0;
    }
  }

  &__value,
  &__arrow {
    color: $color-text-secondary;
  }

  .is-danger {
    color: #df4f55;
  }
}
</style>
