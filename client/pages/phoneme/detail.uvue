<template><view class="page"><LessonProgress :current="4" :total="20"/><text class="label">短元音</text><text class="ipa">/æ/</text><text class="description">接近「爱」，嘴巴张得更大</text><view class="listen"><PlayButton/><text class="listen-text">听发音</text><text class="slow">◷ 慢速</text></view><view class="card mouth"><text class="card-title">怎么发音</text><text class="mouth-symbol">◡</text><view class="steps"><text>❶　嘴巴自然张大</text><text>❷　舌尖靠近下齿</text><text>❸　声音短促，不要拖长</text></view></view><text class="section-title">放进单词里听</text><view class="card words"><view v-for="item in words" :key="item.word" class="word-row"><PlayButton/><text class="word">{{item.word}}</text><text class="muted">{{item.ipa}}</text><text class="meaning">{{item.zh}}</text></view></view><TipCard text="像突然张嘴说「爱」，但声音更短、更扁。"/><text class="compare" @click="goCompare">容易和哪个音混淆？对比 /e/　›</text><StepActions @next="goCompare"/></view></template>
<script lang="uts">import LessonProgress from '../../components/LessonProgress/index.uvue';import PlayButton from '../../components/PlayButton/index.uvue';import TipCard from '../../components/TipCard/index.uvue';import StepActions from '../../components/StepActions/index.uvue';export default{components:{LessonProgress,PlayButton,TipCard,StepActions},data(){return{words:[{word:'cat',ipa:'/kæt/',zh:'猫'},{word:'map',ipa:'/mæp/',zh:'地图'},{word:'happy',ipa:"/'hæpi/",zh:'开心的'}]}},methods:{goCompare(){uni.navigateTo({url:'/pages/phoneme/compare'})}}}</script>
<style lang="scss">@import '../../uni.scss';.label{display:block;margin-top:40rpx;color:$color-text-secondary;font-size:27rpx}.ipa{display:block;text-align:center;color:$color-primary;font-size:94rpx;font-weight:600}.description{display:block;text-align:center;color:$color-text-secondary;font-size:28rpx}.listen{margin:28rpx 0;display:flex;align-items:center;justify-content:center;gap:22rpx}.listen-text{color:$color-primary;font-size:29rpx;font-weight:600}.slow{padding:12rpx 18rpx;border:1rpx solid $color-border;border-radius:28rpx;color:$color-text-secondary}.card-title{font-size:28rpx;font-weight:700}.mouth-symbol{display:block;text-align:center;color:$color-primary;font-size:160rpx;line-height:180rpx}.steps{display:flex;flex-direction:column;gap:16rpx;width:330rpx;margin:auto;font-size:25rpx}.words{padding:0}.word-row{height:78rpx;padding:0 26rpx;border-bottom:1rpx solid $color-border;display:flex;align-items:center;gap:26rpx}.word-row:last-child{border:0}.word{width:100rpx;font-weight:600}.meaning{margin-left:auto}.compare{display:block;margin:24rpx 4rpx;color:$color-primary;font-size:24rpx}</style>
