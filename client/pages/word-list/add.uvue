<template>
  <view class="page">
    <RequestState v-if="!loaded" :error="error" @retry="loadLibraries" />
    <WordLibrarySelector
      v-else
      :items="availableLibraries"
      @view="viewLibrary"
      @custom="openCustomPage"
    />
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import WordLibrarySelector from '../../components/WordLibrarySelector/index.uvue'
import RequestState from '../../components/RequestState/index.uvue'
import { storeToRefs } from 'pinia'
import { useLibraryStore } from '../../src/stores/library.uts'
import type { HttpError } from '../../src/config/types.uts'

const libraryStore = useLibraryStore()
const { availableLibraries } = storeToRefs(libraryStore)
const loaded = ref(false)
const error = ref('')

async function loadLibraries() {
  error.value = ''
  try {
    await libraryStore.loadAvailable()
    loaded.value = true
  } catch (failure) {
    loaded.value = false
    error.value = (failure as HttpError).message
  }
}

function viewLibrary(id: string) {
  uni.navigateTo({ url: '/pages/word-list/detail?id=' + encodeURIComponent(id) })
}

function openCustomPage() {
  uni.navigateTo({ url: '/pages/word-list/custom' })
}
onShow(loadLibraries)
</script>
