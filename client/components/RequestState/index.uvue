<template>
  <view v-if="error.length > 0" class="request-state">
    <text>{{ error }}</text>
    <button class="outline-button" @click="$emit('retry')">重试</button>
  </view>
</template>

<script setup lang="uts">
withDefaults(defineProps<{ error?: string }>(), { error: '' })
defineEmits(['retry'])
</script>

<style lang="scss">
.request-state {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 24rpx;
  padding: 40rpx 0;
  text-align: center;
}
</style>
