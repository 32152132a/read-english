export const DEFAULT_LEARNING_FLOW: LearningFlowNode[] = [
  { id: 'default-phoneme', templateCode: 'phoneme' },
  { id: 'default-phoneme-compare', templateCode: 'phoneme-compare' },
  { id: 'default-phoneme-quiz', templateCode: 'phoneme-quiz' },
  { id: 'default-syllable', templateCode: 'syllable' },
  { id: 'default-ipa-decoding', templateCode: 'ipa-decoding' },
  { id: 'default-word-decoding', templateCode: 'word-decoding' },
  { id: 'default-evaluation', templateCode: 'evaluation' },
]

function cloneNodes(nodes: LearningFlowNode[]): LearningFlowNode[] {
  return nodes.map((node) => ({ ...node }))
}

let mockFlowNodes = cloneNodes(DEFAULT_LEARNING_FLOW)
let mockCurrentNodeIndex = 1

// 当前使用 Mock；接入后端时只替换本文件中的流程请求方法。
export function getLearningFlow(): Promise<LearningFlowConfig> {
  return Promise.resolve({
    nodes: cloneNodes(mockFlowNodes),
    currentNodeIndex: mockCurrentNodeIndex,
  })
}

export function saveLearningFlow(nodes: LearningFlowNode[]): Promise<LearningFlowConfig> {
  mockFlowNodes = cloneNodes(nodes)
  mockCurrentNodeIndex = 0
  return Promise.resolve({
    nodes: cloneNodes(mockFlowNodes),
    currentNodeIndex: mockCurrentNodeIndex,
  })
}

export function completeLearningStage(): Promise<LearningFlowConfig> {
  if (mockCurrentNodeIndex < mockFlowNodes.length) mockCurrentNodeIndex += 1
  return Promise.resolve({
    nodes: cloneNodes(mockFlowNodes),
    currentNodeIndex: mockCurrentNodeIndex,
  })
}
