<template>
  <view class="page">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <IpaReadingCard :data="pageData.card" />
    <StepActions :current="pageData.current" :total="pageData.total" @change="loadStep" />
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
import IpaReadingCard from '../../components/IpaReadingCard/index.uvue'
const pageData = reactive({
  id: 'ipa-decoding-component',
  current: 2,
  total: 3,
  card: {
    word: 'component',
    hint: '听一听，再试着把音节连起来读',
    ipaSegments: [{ text: '/kəmˈpəʊnənt/', tone: 'primary' }],
    parts: [
      { text: 'kəm', emphasized: false },
      { text: 'pəʊ', emphasized: true },
      { text: 'nənt', emphasized: false },
    ],
    audioUrl: '',
  },
})
const stepList = [
  {
    id: 'ipa-decoding-fantastic',
    ipaSegments: [{ text: '/fænˈtæstɪk/', tone: 'primary' }],
    answerWord: 'fantastic',
    parts: [
      { text: 'fæn', emphasized: false },
      { text: 'tæs', emphasized: true },
      { text: 'tɪk', emphasized: false },
    ],
  },
  {
    id: 'ipa-decoding-component',
    ipaSegments: [{ text: '/kəmˈpəʊnənt/', tone: 'primary' }],
    answerWord: 'component',
    parts: [
      { text: 'kəm', emphasized: false },
      { text: 'pəʊ', emphasized: true },
      { text: 'nənt', emphasized: false },
    ],
  },
  {
    id: 'ipa-decoding-important',
    ipaSegments: [{ text: '/ɪmˈpɔːtənt/', tone: 'primary' }],
    answerWord: 'important',
    parts: [
      { text: 'ɪm', emphasized: false },
      { text: 'pɔː', emphasized: true },
      { text: 'tənt', emphasized: false },
    ],
  },
]

function loadStep(target: number) {
  const step = stepList[target - 1]
  if (step == null) return

  pageData.id = step.id
  pageData.current = target
  pageData.card.word = step.answerWord
  pageData.card.ipaSegments = step.ipaSegments
  pageData.card.parts = step.parts
}
</script>
