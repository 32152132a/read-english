  text-align: center;
}
.word {
  display: block;
  font-size: 58rpx;
  font-weight: 700;
}
.ipa {
  display: block;
  margin: 18rpx;
  color: $color-text-secondary;
  font-size: 34rpx;
}
.chunks {
  font-size: 42rpx;
}
.blue {
  color: #1451ff;
}
.green {
  color: #14a76c;
}
.purple {
  color: #7c3cff;
}
.rules {
  margin-top: 28rpx;
}
.first {
  margin-top: 0;
}
.rule {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 0;
}
.number {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: $color-primary;
  color: #fff;
  text-align: center;
  line-height: 46rpx;
}
.rule-title,
.rule-text {
  display: block;
}
.rule-title {
  font-weight: 600;
}
.rule-text {
  margin-top: 6rpx;
}
.question {
  margin-top: 28rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}
.answers {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}
.answers text {
  flex: 1;
  padding: 18rpx;
  border: 1rpx solid $color-border;
  border-radius: 10rpx;
}
.answers .chosen {
  border-color: $color-primary;
  color: $color-primary;
  background: #f3f6ff;
}
</style>
