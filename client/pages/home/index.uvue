<template>
  <view class="screen">
    <view class="page home">
      <RequestState v-if="home == null" :error="error" @retry="loadHome" />
      <template v-else>
        <view class="home-head">
          <text class="greeting">{{ home!.greeting }}</text>
          <text class="subtitle">{{ home!.subtitle }}</text>
        </view>
        <TodayLessonCard :data="todayTask" @continue="continueLearning" />
        <text class="section-title">学习路径</text>
        <LearningPath :steps="learningSteps" :current-index="currentIndex" @select="go" />
        <text class="section-title">常用功能</text>
        <QuickAccessList :items="quickActions" @select="go" />
      </template>
    </view>
    <BottomNav active="home" />
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import BottomNav from '../../components/BottomNav/index.uvue'
import TodayLessonCard from '../../components/TodayLessonCard/index.uvue'
import LearningPath from '../../components/LearningPath/index.uvue'
import QuickAccessList from '../../components/QuickAccessList/index.uvue'
import RequestState from '../../components/RequestState/index.uvue'
import { request } from '../../src/services/http.uts'
import { getToken } from '../../src/services/token.uts'
import type { HomeResponse } from '../../src/config/api-types.uts'
import type { HttpError } from '../../src/config/types.uts'

const home = ref<HomeResponse | null>(null)
const error = ref('')
const currentIndex = computed(
  () => home.value?.learningPath.filter((node) => node.reviewable).length ?? 0
)
const learningSteps = computed(() =>
  (home.value?.learningPath ?? []).map((node, index) => ({
    code: node.id,
    name: node.name,
    route: node.route + '?flowNodeId=' + encodeURIComponent(node.id) + '&review=true',
    state: node.reviewable ? 'completed' : index === currentIndex.value ? 'active' : 'pending',
  }))
)
const quickActions = computed(() =>
  (home.value?.quickActions ?? []).map((item) => ({
    ...item,
    description: item.code === 'phoneme-overview' ? '快速查阅' : '实际应用',
    iconName: item.code === 'phoneme-overview' ? 'volume-2' : 'book-open',
  }))
)
const todayTask = computed(() => ({
  tag: '今日学习',
  title: home.value?.todayTask?.title ?? '本轮学习已完成',
  description: home.value?.todayTask?.description ?? '可以调整流程，开始下一轮学习',
  durationMinutes: home.value?.todayTask?.estimatedMinutes ?? 0,
  actionText: home.value?.flowCompleted ? '查看学习流程' : '继续学习',
  progressLabel: '学习流程',
  current: Math.min(currentIndex.value + 1, learningSteps.value.length),
  total: learningSteps.value.length,
}))

async function loadHome() {
  if (getToken().length === 0) {
    home.value = null
    uni.reLaunch({ url: '/pages/login/index' })
    return
  }
  error.value = ''
  try {
    home.value = await request<HomeResponse>({ url: '/home', showError: false })
  } catch (failure) {
    home.value = null
    error.value = (failure as HttpError).message
  }
}

function go(url: string) {
  if (url.length > 0) uni.navigateTo({ url })
}

function continueLearning() {
  const task = home.value?.todayTask
  go(
    task == null
      ? '/pages/profile/learning-flow'
      : task.route + '?flowNodeId=' + encodeURIComponent(task.flowNodeId)
  )
}

onShow(loadHome)
</script>
<style lang="scss">
@import '../../uni.scss';

.screen {
  min-height: 100vh;
}
.home {
  overflow-x: hidden;
  padding-top: 84rpx;
  padding-bottom: 164rpx;
}

.home-head {
  .greeting {
    display: block;
    font-size: 48rpx;
    font-weight: 700;
  }
  .subtitle {
    display: block;
    margin-top: 12rpx;
    color: $color-text-secondary;
  }
}
</style>
