<template>
  <view class="page">
    <RequestState v-if="unit == null" :error="error" @retry="loadSession" />
    <template v-else>
      <LessonProgress :current="current" :total="total" />
      <text class="page-title centered">{{ unit!.title }}</text>
      <TipCard
        title="拆分思路"
        :items="unit!.content!.teachingConfig?.commonTips ?? unit!.content!.commonTips"
        note="规则用于帮助推测，最终以音标和实际发音为准。"
      />
      <WordDecodingCard :key="unit!.id" :data="exercise" />
      <StepActions
        :current="current"
        :total="total"
        @change="loadStep"
        @complete="completeCurrentStage"
      />
    </template>
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import RequestState from '../../components/RequestState/index.uvue'
import LessonProgress from '../../components/LessonProgress/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
import { useLearningSession } from '../../src/composables/use-learning-session.uts'
import TipCard from '../../components/TipCard/index.uvue'
import WordDecodingCard from '../../components/WordDecodingCard/index.uvue'
import type { WordContent } from '../../src/config/api-types.uts'

const { unit, current, total, error, loadSession, loadStep, completeCurrentStage } =
  useLearningSession<WordContent>('word-decoding')
const exercise = computed(() => ({
  id: unit.value?.id ?? '',
  word: unit.value?.content.word ?? '',
  audioUrl: unit.value?.content.audioUrl ?? '',
  specialTips:
    unit.value?.content.teachingConfig?.specialTips ?? unit.value?.content.specialTips ?? [],
  mappings:
    unit.value?.content.teachingConfig?.parts?.map((part) => ({
      part: part.letters,
      segments: part.segments,
      tip: part.tip,
    })) ??
    (unit.value?.content.parts ?? []).map((part) => ({
      part: part.letters,
      segments: [{ text: part.ipa, tone: 'primary' }],
      tip: '',
    })),
}))
</script>
