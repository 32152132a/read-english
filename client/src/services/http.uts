import { clearToken, getAuthorization, getRefreshToken, setLoginTokens } from './token.uts'
import type { HttpError, HttpOptions } from '../config/types.uts'
import type { ApiResponse, LoginResponse } from '../config/api-types.uts'

const apiBaseUrl = import.meta.env.VITE_API_BASE_URL || '/api/v1'
const loadingDelay = 150

function createHttpError(statusCode: number, message: string, data: any | null): HttpError {
  return {
    statusCode,
    code: data?.code ?? 'NETWORK_ERROR',
    message: data?.message ?? message,
    requestId: data?.requestId ?? '',
    data,
  }
}

let refreshPromise: Promise<LoginResponse> | null = null

async function refreshLogin() {
  if (refreshPromise == null) {
    refreshPromise = request<LoginResponse>({
      url: '/auth/refresh',
      method: 'POST',
      auth: false,
      showLoading: false,
      data: { refreshToken: getRefreshToken() },
    })
      .then((login) => {
        setLoginTokens(login.accessToken, login.refreshToken)
        return login
      })
      .finally(() => {
        refreshPromise = null
      })
  }
  await refreshPromise
}

export function showRequestError(error: unknown) {
  const message = (error as HttpError)?.message ?? '操作失败，请重试'
  uni.showToast({ title: message, icon: 'none' })
}

let loadingCount = 0
let loadingTimer = 0
let loadingVisible = false
let errorPageOpening = false

export function getApiBaseUrl(): string {
  return apiBaseUrl
}

function startLoading(text: string) {
  loadingCount += 1
  if (loadingCount > 1) return

  loadingTimer = setTimeout(() => {
    loadingVisible = true
    uni.showLoading({ title: text, mask: true })
  }, loadingDelay)
}

function finishLoading() {
  loadingCount = loadingCount > 0 ? loadingCount - 1 : 0
  if (loadingCount > 0) return

  clearTimeout(loadingTimer)
  loadingTimer = 0
  if (!loadingVisible) return

  loadingVisible = false
  uni.hideLoading()
}

function openErrorPage(statusCode: number) {
  if (errorPageOpening) return

  errorPageOpening = true
  uni.navigateTo({
    url: `/pages/error/${statusCode}`,
    complete: () => {
      setTimeout(() => {
        errorPageOpening = false
      }, 500)
    },
  })
}

function handleStatus(statusCode: number) {
  if (statusCode === 401) {
    clearToken()
    uni.showToast({ title: '登录已过期，请重新登录', icon: 'none' })
    return
  }

  if (statusCode === 404 || statusCode >= 500) {
    openErrorPage(statusCode === 404 ? 404 : 500)
  }
}

export function request<T>(options: HttpOptions, retry: boolean = true): Promise<T> {
  const shouldShowLoading = options.showLoading !== false
  const headers: UTSJSONObject = { 'Content-Type': 'application/json', ...options.header }
  const authorization = getAuthorization()

  if (options.auth !== false && authorization.length > 0) {
    headers['Authorization'] = authorization
  }
  if (shouldShowLoading) startLoading(options.loadingText ?? '加载中')

  return new Promise<T>((resolve, reject) => {
    uni.request<ApiResponse<T>>({
      url: options.url.startsWith('http') ? options.url : `${apiBaseUrl}${options.url}`,
      method: options.method ?? 'GET',
      data: options.data,
      header: headers,
      timeout: options.timeout ?? 10000,
      success: async (response) => {
        if (
          response.statusCode >= 200 &&
          response.statusCode < 300 &&
          response.data?.code === 'OK'
        ) {
          resolve(response.data.data)
          return
        }

        if (
          response.statusCode === 401 &&
          options.auth !== false &&
          retry &&
          getRefreshToken().length > 0
        ) {
          try {
            await refreshLogin()
            resolve(await request<T>(options, false))
          } catch (error) {
            if ((error as HttpError).statusCode === 401) clearToken()
            reject(error)
          }
          return
        }

        handleStatus(response.statusCode)
        reject(
          createHttpError(response.statusCode, `请求失败（${response.statusCode}）`, response.data)
        )
      },
      fail: (error) => {
        uni.showToast({ title: '网络连接失败，请稍后重试', icon: 'none' })
        reject(createHttpError(0, error.errMsg, null))
      },
      complete: () => {
        if (shouldShowLoading) finishLoading()
      },
    })
  })
}
