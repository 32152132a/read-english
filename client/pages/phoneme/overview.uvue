<template>
  <view class="page">
    <RequestState v-if="groups == null" :error="error" @retry="loadOverview" />
    <template v-else>
      <PhonemeCatalog
        title="国际音标速查"
        :description="description"
        :vowels="vowels"
        :consonants="consonants"
        @select="openDetail"
      />
      <button
        v-if="flowNodeId.length > 0"
        class="primary-button phoneme-overview__complete"
        @click="completeOverview"
      >
        {{ review ? '返回学习路径' : '完成查阅，进入下一阶段' }}
      </button>
    </template>
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import PhonemeCatalog from '../../components/PhonemeCatalog/index.uvue'
import RequestState from '../../components/RequestState/index.uvue'
import { request } from '../../src/services/http.uts'
import { useLearningFlowNavigation } from '../../src/composables/use-learning-flow-navigation.uts'
import type { PhonemeGroups } from '../../src/config/api-types.uts'
import type { HttpError } from '../../src/config/types.uts'

const groups = ref<PhonemeGroups | null>(null)
const error = ref('')
const flowNodeId = ref('')
const review = ref(false)
const navigation = useLearningFlowNavigation()
const vowels = computed(() => itemsFor('VOWEL'))
const consonants = computed(() => itemsFor('CONSONANT'))
const description = computed(
  () => '当前收录 ' + (vowels.value.length + consonants.value.length) + ' 个音标'
)

function itemsFor(code: string) {
  return (groups.value?.groups.find((group) => group.code === code)?.items ?? []).map((item) => ({
    id: item.id,
    segments: [{ text: item.ipa, tone: 'muted' }],
    audioUrl: item.audioUrl ?? '',
  }))
}

async function loadOverview() {
  error.value = ''
  try {
    groups.value = await request<PhonemeGroups>({ url: '/phonemes' })
  } catch (failure) {
    error.value = (failure as HttpError).message
  }
}

function openDetail(id: string) {
  uni.navigateTo({ url: '/pages/phoneme/detail?phonemeId=' + encodeURIComponent(id) })
}

async function completeOverview() {
  await navigation.completeCurrentStage(flowNodeId.value, '', review.value)
}

onLoad((options) => {
  flowNodeId.value = options['flowNodeId'] ?? ''
  review.value = options['review'] === 'true'
  loadOverview()
})
</script>
<style lang="scss">
.phoneme-overview__complete {
  width: 100%;
  margin-top: 28rpx;
}
</style>
