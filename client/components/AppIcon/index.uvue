<template>
  <image
    class="app-icon"
    :src="iconSource"
    :style="{ width: size + 'rpx', height: size + 'rpx' }"
    mode="aspectFit"
    :aria-label="label"
  />
</template>

<script setup lang="uts">
import type { AppIconProps } from '../../src/config/types.uts'

const iconNames = [
  'chevron-left',
  'search',
  'play',
  'volume-2',
  'clock-3',
  'mic',
  'house',
  'user-round',
  'book-open',
  'headphones',
  'audio-waveform',
  'lightbulb',
  'circle-check',
  'lock-keyhole',
  'eye',
  'eye-off',
]

const props = withDefaults(defineProps<AppIconProps>(), {
  size: 48,
  active: false,
  tone: 'default',
  label: '',
})

const iconSource = computed((): string => {
  const iconName = iconNames.includes(props.name) ? props.name : 'circle-check'
  if (props.active && ['house', 'user-round'].includes(iconName)) {
    return '/static/icons/' + iconName + '-active.svg'
  }
  if (props.tone === 'dark' && ['book-open', 'headphones', 'audio-waveform'].includes(iconName)) {
    return '/static/icons/' + iconName + '-dark.svg'
  }
  return '/static/icons/' + iconName + '.svg'
})
</script>

<style lang="scss">
.app-icon {
  display: block;
  flex-shrink: 0;
}
</style>
