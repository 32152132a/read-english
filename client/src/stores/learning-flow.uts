import { defineStore } from 'pinia'
import type { LearningFlowNode, LearningFlowTemplate } from '../config/types.uts'
import type { FlowNode, FlowConfig } from '../config/api-types.uts'
import {
  DEFAULT_LEARNING_FLOW,
  getLearningFlow,
  getLearningFlowTemplates,
  saveLearningFlow,
} from '../services/learning-flow.uts'

export const useLearningFlowStore = defineStore('learning-flow', () => {
  const templates = ref<LearningFlowTemplate[]>([])
  const nodes = ref<FlowNode[]>([])
  const currentNodeIndex = ref(0)
  const version = ref(0)
  const defaultNodes = DEFAULT_LEARNING_FLOW

  function applyFlow(flow: FlowConfig) {
    nodes.value = flow.nodes
    version.value = flow.version
    currentNodeIndex.value = flow.currentNodeIndex
  }

  async function loadFlow() {
    const [flow, availableTemplates] = await Promise.all([
      getLearningFlow(),
      getLearningFlowTemplates(),
    ])
    templates.value = availableTemplates
      .filter((item) => item.enabled)
      .map((item) => ({ ...item, iconName: '' }))
    applyFlow(flow)
  }

  async function submitFlow(nextNodes: LearningFlowNode[]) {
    applyFlow(await saveLearningFlow(nextNodes, version.value))
  }

  return { templates, nodes, currentNodeIndex, defaultNodes, loadFlow, submitFlow }
})
