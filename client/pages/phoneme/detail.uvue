<template>
  <view class="page phoneme-detail">
    <RequestState v-if="content == null" :error="error" @retry="retry" />
    <template v-else>
      <LessonProgress v-if="!browsing" :current="current" :total="total" label="" compact />
      <text class="phoneme-detail__category">{{ content!.category }}</text>
      <PhonemeDisplay
        :segments="
          content!.teachingConfig?.ipaSegments ?? [{ text: content!.ipa, tone: 'primary' }]
        "
        size="hero"
      />
      <text class="phoneme-detail__description">{{ content!.description }}</text>
      <view class="phoneme-detail__listen">
        <PlayButton
          :src="phonemeAudio"
          :word="content!.fallbackWord ?? ''"
          :accent="accent"
          :text="phonemeAudio.length > 0 ? '听发音' : '听例词'"
          size="hero"
        />
      </view>
      <PronunciationGuide
        :mouth-type="content!.mouth.type"
        :mouth-image-url="content!.mouth.imageUrl"
        :steps="content!.pronunciationSteps"
      />
      <text class="section-title">例词发音</text>
      <ExampleWordList :items="examples" />
      <TipCard title="记忆技巧" :text="content!.memoryTip" variant="memory" />
      <StepActions
        v-if="!browsing"
        :current="current"
        :total="total"
        @change="loadStep"
        @complete="completeCurrentStage"
      />
    </template>
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import RequestState from '../../components/RequestState/index.uvue'
import LessonProgress from '../../components/LessonProgress/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
import { useLearningSession } from '../../src/composables/use-learning-session.uts'
import PlayButton from '../../components/PlayButton/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import PhonemeDisplay from '../../components/PhonemeDisplay/index.uvue'
import PronunciationGuide from '../../components/PronunciationGuide/index.uvue'
import ExampleWordList from '../../components/ExampleWordList/index.uvue'
import { request } from '../../src/services/http.uts'
import type { PhonemeContent } from '../../src/config/api-types.uts'
import type { HttpError } from '../../src/config/types.uts'
import { getAccentPreference } from '../../src/services/accent.uts'

const { unit, current, total, error, loadSession, loadStep, completeCurrentStage } =
  useLearningSession<PhonemeContent>('phoneme')
const detail = ref<PhonemeContent | null>(null)
const browsing = ref(false)
const accent = ref(getAccentPreference())
let phonemeId = ''
const content = computed(() => detail.value ?? unit.value?.content ?? null)
const phonemeAudio = computed(() => {
  const value = content.value
  if (value == null) return ''
  const preferred = accent.value === 'GB' ? value.audioGbUrl : value.audioUsUrl
  return preferred?.length ? preferred : (value.audioUrl ?? '')
})
const examples = computed(() =>
  (content.value?.exampleWords ?? []).map((word) => ({
    word: word.word,
    segments: [{ text: word.ipa, tone: 'muted' }],
    zh: word.meaning,
    audioUrl: word.audioUrl ?? '',
  }))
)

async function retry() {
  if (!browsing.value) {
    await loadSession()
    return
  }
  error.value = ''
  try {
    detail.value = await request<PhonemeContent>({
      showError: false,
      url: '/phonemes/' + encodeURIComponent(phonemeId),
    })
  } catch (failure) {
    error.value = (failure as HttpError).message
  }
}

onLoad((options) => {
  phonemeId = options['phonemeId'] ?? ''
  browsing.value = phonemeId.length > 0
  if (browsing.value) retry()
})
onShow(() => {
  accent.value = getAccentPreference()
})
</script>
<style lang="scss">
@import '../../uni.scss';

.phoneme-detail {
  &__category {
    display: block;
    margin-top: 20rpx;
    color: $color-text-secondary;
    font-size: 27rpx;
  }

  &__description {
    display: block;
    margin-top: 8rpx;
    text-align: center;
    color: $color-text-secondary;
    font-size: 28rpx;
  }

  &__listen {
    margin: 26rpx 0 30rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28rpx;
  }
}
</style>
