<template>
  <view class="page">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <text class="page-title centered">{{ pageData.title }}</text>
    <TipCard :text="pageData.tip" />
    <view class="word-parts">
      <text v-for="part in pageData.parts" :key="part.text" :class="part.stressed ? 'focus' : ''">
        {{ part.text }}
      </text>
    </view>
    <view class="tiles">
      <text v-for="part in pageData.parts" :key="part.text">{{ part.text }}</text>
    </view>
    <text class="muted centered">拖动分隔符调整拆分</text>
    <text class="section-title">字母与发音</text>
    <view class="card mappings">
      <view v-for="m in pageData.mappings" :key="m.part">
        <text class="part">{{ m.part }}</text>
        <text>→</text>
        <text>{{ m.ipa }}</text>
        <text class="muted">{{ m.tip }}</text>
      </view>
    </view>
    <StepActions :current="pageData.current" :total="pageData.total" @change="loadStep" />
  </view>
</template>
<script lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
export default {
  components: { LessonProgress, TipCard, StepActions },
  data() {
    return {
      pageData: {
        id: 'word-decoding-component',
        current: 5,
        total: 12,
        title: '根据字母组合推测读音',
        tip: '非重读音节中的 o 常弱读为 /ə/',
        word: 'component',
        ipa: '/kəmˈpəʊnənt/',
        audioUrl: '',
        parts: [
          { text: 'com', stressed: false },
          { text: 'po', stressed: true },
          { text: 'nent', stressed: false },
        ],
        mappings: [
          { part: 'com', ipa: '/kəm/', tip: '辅音 + o 弱读 /ə/' },
          { part: 'po', ipa: '/pəʊ/', tip: '开音节 o 发 /əʊ/' },
          { part: 'nent', ipa: '/nənt/', tip: '结尾 t 不发音' },
        ],
      },
    }
  },
  methods: {
    loadStep(target: number) {
      if (target < this.pageData.current) uni.navigateBack()
    },
  },
}
</script>
