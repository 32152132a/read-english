<template>
  <view class="page">
    <PhonemeCatalog
      :title="pageData.title"
      :description="pageData.description"
      :vowels="vowels"
      :consonants="consonants"
      @select="openDetail"
    />
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import PhonemeCatalog from '../../components/PhonemeCatalog/index.uvue'
const pageData = reactive({
  title: '国际音标速查',
  description: '共 44 个音标，点击喇叭试听发音',
  singleVowels: [
    { id: 'i-long', segments: [{ text: 'iː', tone: 'primary' }], audioUrl: '' },
    { id: 'i-short', segments: [{ text: 'ɪ', tone: 'primary' }], audioUrl: '' },
    { id: 'e', segments: [{ text: 'e', tone: 'primary' }], audioUrl: '' },
    { id: 'ae', segments: [{ text: 'æ', tone: 'primary' }], audioUrl: '' },
    { id: 'a-long', segments: [{ text: 'ɑː', tone: 'primary' }], audioUrl: '' },
    { id: 'o-short', segments: [{ text: 'ɒ', tone: 'primary' }], audioUrl: '' },
    { id: 'o-long', segments: [{ text: 'ɔː', tone: 'primary' }], audioUrl: '' },
    { id: 'u-short', segments: [{ text: 'ʊ', tone: 'primary' }], audioUrl: '' },
    { id: 'u-long', segments: [{ text: 'uː', tone: 'primary' }], audioUrl: '' },
    { id: 'caret', segments: [{ text: 'ʌ', tone: 'primary' }], audioUrl: '' },
    { id: 'er-long', segments: [{ text: 'ɜː', tone: 'primary' }], audioUrl: '' },
    { id: 'schwa', segments: [{ text: 'ə', tone: 'primary' }], audioUrl: '' },
  ],
  diphthongs: [
    { id: 'ei', segments: [{ text: 'eɪ', tone: 'primary' }], audioUrl: '' },
    { id: 'ai', segments: [{ text: 'aɪ', tone: 'primary' }], audioUrl: '' },
    { id: 'oi', segments: [{ text: 'ɔɪ', tone: 'primary' }], audioUrl: '' },
    { id: 'au', segments: [{ text: 'aʊ', tone: 'primary' }], audioUrl: '' },
    { id: 'ou', segments: [{ text: 'əʊ', tone: 'primary' }], audioUrl: '' },
    { id: 'ia', segments: [{ text: 'ɪə', tone: 'primary' }], audioUrl: '' },
    { id: 'ea', segments: [{ text: 'eə', tone: 'primary' }], audioUrl: '' },
    { id: 'ua', segments: [{ text: 'ʊə', tone: 'primary' }], audioUrl: '' },
  ],
  plosives: [
    { id: 'p', segments: [{ text: 'p', tone: 'primary' }], audioUrl: '' },
    { id: 'b', segments: [{ text: 'b', tone: 'primary' }], audioUrl: '' },
    { id: 't', segments: [{ text: 't', tone: 'primary' }], audioUrl: '' },
    { id: 'd', segments: [{ text: 'd', tone: 'primary' }], audioUrl: '' },
    { id: 'k', segments: [{ text: 'k', tone: 'primary' }], audioUrl: '' },
    { id: 'g', segments: [{ text: 'g', tone: 'primary' }], audioUrl: '' },
  ],
  fricatives: [
    { id: 'f', segments: [{ text: 'f', tone: 'primary' }], audioUrl: '' },
    { id: 'v', segments: [{ text: 'v', tone: 'primary' }], audioUrl: '' },
    { id: 'theta', segments: [{ text: 'θ', tone: 'primary' }], audioUrl: '' },
    { id: 'eth', segments: [{ text: 'ð', tone: 'primary' }], audioUrl: '' },
    { id: 's', segments: [{ text: 's', tone: 'primary' }], audioUrl: '' },
    { id: 'z', segments: [{ text: 'z', tone: 'primary' }], audioUrl: '' },
    { id: 'esh', segments: [{ text: 'ʃ', tone: 'primary' }], audioUrl: '' },
    { id: 'ezh', segments: [{ text: 'ʒ', tone: 'primary' }], audioUrl: '' },
    { id: 'h', segments: [{ text: 'h', tone: 'primary' }], audioUrl: '' },
  ],
  affricates: [
    { id: 't-esh', segments: [{ text: 'tʃ', tone: 'primary' }], audioUrl: '' },
    { id: 'd-ezh', segments: [{ text: 'dʒ', tone: 'primary' }], audioUrl: '' },
  ],
  otherConsonants: [
    { id: 'm', segments: [{ text: 'm', tone: 'primary' }], audioUrl: '' },
    { id: 'n', segments: [{ text: 'n', tone: 'primary' }], audioUrl: '' },
    { id: 'eng', segments: [{ text: 'ŋ', tone: 'primary' }], audioUrl: '' },
    { id: 'l', segments: [{ text: 'l', tone: 'primary' }], audioUrl: '' },
    { id: 'r', segments: [{ text: 'r', tone: 'primary' }], audioUrl: '' },
    { id: 'j', segments: [{ text: 'j', tone: 'primary' }], audioUrl: '' },
    { id: 'w', segments: [{ text: 'w', tone: 'primary' }], audioUrl: '' },
  ],
  detailRoute: '/pages/phoneme/detail',
})
const vowels = computed(() => pageData.singleVowels.concat(pageData.diphthongs))
const consonants = computed(() =>
  pageData.plosives
    .concat(pageData.fricatives)
    .concat(pageData.affricates)
    .concat(pageData.otherConsonants)
)

function openDetail(id: string) {
  uni.navigateTo({ url: `${pageData.detailRoute}?id=${id}` })
}
</script>
