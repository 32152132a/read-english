<template>
  <view class="evaluation-result">
    <view class="evaluation-result__header">
      <text>{{ title }}</text>
    </view>
    <view class="evaluation-result__scores">
      <view v-for="score in scores" :key="score.code" class="evaluation-result__score">
        <text>{{ score.label }}</text>
        <text class="evaluation-result__value" :class="getScoreTone(score.value)">
          {{ score.value }}
        </text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import type { EvaluationResultProps, EvaluationScore } from '../../src/config/types.uts'

withDefaults(defineProps<EvaluationResultProps>(), {
  title: '',
  scores: (): EvaluationScore[] => [],
})

function getScoreTone(value: number) {
  if (value >= 85) return 'is-good'
  if (value >= 60) return 'is-medium'
  return 'is-low'
}
</script>

<style lang="scss">
@import '../../uni.scss';

.evaluation-result {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid $color-border;
  border-radius: 18rpx;
  background: #fff;

  &__scores {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 30rpx;
  }

  &__score {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 12rpx;
    color: $color-text-secondary;
  }

  &__value {
    font-size: 44rpx;
    color: #df4f55;

    &.is-good {
      color: $color-success;
    }

    &.is-medium {
      color: #f29b00;
    }
  }
}
</style>
