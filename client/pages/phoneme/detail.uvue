<template>
  <view class="page">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <text class="label">{{ pageData.category }}</text>
    <text class="ipa">{{ pageData.ipa }}</text>
    <text class="description">{{ pageData.description }}</text>
    <TipCard :text="pageData.memoryTip" />
    <view class="listen">
      <PlayButton :src="pageData.audioUrl" text="听发音" />
      <text class="slow">◷ 慢速</text>
    </view>
    <view class="card mouth">
      <text class="card-title">怎么发音</text>
      <text class="mouth-symbol">◡</text>
      <view class="steps">
        <text v-for="(step, index) in pageData.mouthSteps" :key="step">
          {{ index + 1 }}　{{ step }}
        </text>
      </view>
    </view>
    <text class="section-title">放进单词里听</text>
    <view class="card words">
      <view v-for="item in pageData.examples" :key="item.word" class="word-row">
        <PlayButton :src="item.audioUrl" size="mini" />
        <text class="word">{{ item.word }}</text>
        <text class="muted">{{ item.ipa }}</text>
        <text class="meaning">{{ item.zh }}</text>
      </view>
    </view>
    <text class="compare" @click="goCompare">{{ pageData.comparisonText }}　›</text>
    <StepActions :current="pageData.current" :total="pageData.total" @change="loadStep" />
  </view>
</template>
<script lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import PlayButton from '../../components/PlayButton/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
export default {
  components: { LessonProgress, PlayButton, TipCard, StepActions },
  data() {
    return {
      pageData: {
        id: 'phoneme-ae',
        current: 4,
        total: 20,
        category: '短元音',
        ipa: '/æ/',
        description: '接近「爱」，嘴巴张得更大',
        memoryTip: '像突然张嘴说「爱」，但声音更短、更扁。',
        audioUrl: '',
        slowAudioUrl: '',
        mouthSteps: ['嘴巴自然张大', '舌尖靠近下齿', '声音短促，不要拖长'],
        examples: [
          { word: 'cat', ipa: '/kæt/', zh: '猫', audioUrl: '' },
          { word: 'map', ipa: '/mæp/', zh: '地图', audioUrl: '' },
          { word: 'happy', ipa: "/'hæpi/", zh: '开心的', audioUrl: '' },
        ],
        comparisonText: '容易和哪个音混淆？对比 /e/',
        comparisonRoute: '/pages/phoneme/compare',
      },
    }
  },
  methods: {
    loadStep(target: number) {
      if (target < this.pageData.current) {
        uni.navigateBack()
        return
      }
      this.goCompare()
    },
    goCompare() {
      uni.navigateTo({ url: this.pageData.comparisonRoute })
    },
  },
}
</script>
