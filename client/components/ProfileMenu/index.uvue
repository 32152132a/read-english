<template>
  <view class="profile-menu">
    <view
      v-for="item in items"
      :key="item.code"
      class="profile-menu__item"
      @click="$emit('select', item.code)"
    >
      <text>{{ item.label }}</text>
      <text v-if="item.value" class="profile-menu__value">{{ item.value }}</text>
      <text class="profile-menu__arrow">›</text>
    </view>
  </view>
</template>

<script lang="uts">
export default {
  props: { items: { type: Array, default: () => [] } },
  emits: ['select'],
}
</script>

