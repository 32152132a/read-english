<template>
  <view class="lesson-progress" :class="compact ? 'lesson-progress--compact' : ''">
    <text class="lesson-progress__label">
      <text v-if="label.length > 0">{{ label }}</text>
      {{ current }} / {{ total }}
    </text>
    <view class="lesson-progress__track">
      <view class="lesson-progress__value" :style="{ width: progressPercent + '%' }"></view>
    </view>
  </view>
</template>

<script setup lang="uts">
import type { LessonProgressProps } from '../../src/config/types.uts'

const props = withDefaults(defineProps<LessonProgressProps>(), {
  label: '学习进度',
  compact: false,
})
const progressPercent = computed((): number => {
  if (props.total <= 0) return 0
  return Math.min(Math.max((props.current / props.total) * 100, 0), 100)
})
</script>

<style lang="scss">
@import '../../uni.scss';

.lesson-progress {
  padding: 24rpx 0 16rpx;

  &__label {
    display: block;
    margin-bottom: 18rpx;
    color: $color-text-secondary;
    font-size: 25rpx;
    line-height: 36rpx;
  }

  &__track {
    height: 7rpx;
    border-radius: 8rpx;
    background-color: $color-border;
    overflow: hidden;
  }

  &__value {
    height: 100%;
    border-radius: inherit;
    background-color: $color-primary;
  }

  &--compact {
    padding-top: 12rpx;

    .lesson-progress__label {
      margin-bottom: 16rpx;
      text-align: right;
      font-size: 27rpx;
    }
  }
}
</style>
