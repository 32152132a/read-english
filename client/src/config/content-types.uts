export type ContentOption = { id: string; label: string }
export type ContentSyllable = { text: string; ipa: string; stress: number; emphasized: boolean }
export type ContentPart = { letters: string; segments: PhonemeSegment[]; tip: string }
export type ContentMouth = { type: string; imageUrl?: string }
export type ContentExample = {
  wordId: string
  accent: string
  word: string
  ipa: string
  meaning: string
  audioUrl?: string
}
export type Pronunciation = { ipa?: string; audioUrl: string }
export type Pronunciations = { US?: Pronunciation; GB?: Pronunciation }
export type ContentAudio = {
  url: string
  usUrl?: string
  gbUrl?: string
}
import type { PhonemeSegment } from './types.uts'
export type ContentQuestion = {
  id: string
  type: string
  prompt: string
  options: ContentOption[]
  correctOptionId?: string
  explanation?: string
  audioUrl?: string
}
export type TeachingConfig = {
  schemaVersion: number
  kind: string
  accent: string
  word?: string
  wordId?: string
  variantKey?: string
  ipa: string
  meaning?: string
  tip?: string
  ipaSegments: PhonemeSegment[]
  syllables?: ContentSyllable[]
  parts?: ContentPart[]
  commonTips?: string[]
  specialTips?: string[]
  category?: string
  group?: string
  description?: string
  mouth?: ContentMouth
  pronunciationSteps?: string[]
  exampleWords?: ContentExample[]
  memoryTip?: string
  audio: ContentAudio
  pronunciations: Pronunciations
  questions: ContentQuestion[]
}
export type ContentEntry = {
  id: string
  kind: string
  label: string
  version: number
}
export type ContentDetail = ContentEntry & { publicResource: boolean; config: TeachingConfig }
export type ContentCapabilities = {
  admin: boolean
  generationEnabled: boolean
  userId: string
  phonemeAudioEnabled: boolean
  phonemeListeningEnabled: boolean
}
export type ContentJob = {
  id: string
  name: string
  status: string
  libraryId: string
  total: number
  completed: number
  succeeded: number
  failed: number
}
export type ContentStudy = { sessionId: string; items: TeachingConfig[] }
