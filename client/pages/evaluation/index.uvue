<template>
  <view class="page">
    <RequestState v-if="unit == null" :error="error" @retry="loadSession" />
    <template v-else>
      <LessonProgress :current="current" :total="total" />
      <EvaluationTarget :data="target" />
      <TipCard
        title="发音评测暂未开放"
        text="评测服务接入后即可录音并获取评分，请先完成其他学习内容。"
      />
    </template>
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import RequestState from '../../components/RequestState/index.uvue'
import LessonProgress from '../../components/LessonProgress/index.uvue'
import EvaluationTarget from '../../components/EvaluationTarget/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import { useLearningSession } from '../../src/composables/use-learning-session.uts'
import type { EvaluationContent } from '../../src/config/api-types.uts'

const { unit, current, total, error, loadSession } =
  useLearningSession<EvaluationContent>('evaluation')
const target = computed(() => {
  const content = unit.value?.content
  const teachingSyllables = content?.teachingConfig?.syllables
  const stressParts = content?.stressParts ?? []

  return {
    word: content?.word ?? '',
    ipaSegments: content?.teachingConfig?.ipaSegments ?? [
      { text: content?.ipa ?? '', tone: 'muted' },
    ],
    syllables:
      teachingSyllables ??
      stressParts.map((text) => ({
        text,
        emphasized: text === text.toUpperCase(),
      })),
    stressIndex:
      (teachingSyllables?.findIndex((item) => item.stress === 1) ??
        stressParts.findIndex((text) => text === text.toUpperCase())) + 1,
    audioUrl: content?.standardAudioUrl ?? '',
  }
})
</script>
