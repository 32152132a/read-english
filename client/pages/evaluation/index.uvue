<template>
  <view class="page">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <EvaluationTarget :data="pageData.word" />
    <RecordingPanel
      :key="pageData.word.id"
      :title="pageData.recordTitle"
      :description="pageData.recordDescription"
      :active-description="pageData.recordingDescription"
      @start="beginRecording"
      @finish="evaluateRecording"
    />
    <EvaluationResult
      v-if="resultVisible"
      :title="pageData.resultTitle"
      :scores="pageData.scores"
    />
    <CorrectionIssue v-if="resultVisible" :data="pageData.correction" />
    <StepActions :current="pageData.current" :total="pageData.total" @change="loadStep" />
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
import EvaluationTarget from '../../components/EvaluationTarget/index.uvue'
import RecordingPanel from '../../components/RecordingPanel/index.uvue'
import EvaluationResult from '../../components/EvaluationResult/index.uvue'
import CorrectionIssue from '../../components/CorrectionIssue/index.uvue'
const pageData = reactive({
  current: 2,
  total: 3,
  word: {
    id: 'component',
    word: 'component',
    ipa: '/kəmˈpəʊnənt/',
    ipaSegments: [{ text: '/kəmˈpəʊnənt/', tone: 'muted' }],
    audioUrl: '',
    stressIndex: 2,
    syllables: [
      { text: 'com', emphasized: false },
      { text: 'po', emphasized: true },
      { text: 'nent', emphasized: false },
    ],
  },
  recordTitle: '点击开始跟读',
  recordDescription: '点击录音，读出上方单词（最长 4 秒）',
  recordingDescription: '再次点击结束并开始评测',
  resultTitle: '本次评测结果',
  scores: [
    { code: 'overall', label: '总分', value: 82 },
    { code: 'accuracy', label: '准确度', value: 78 },
    { code: 'integrity', label: '完整度', value: 100 },
    { code: 'fluency', label: '流利度', value: 84 },
  ],
  correction: {
    targetSegments: [{ text: '/ə/', tone: 'primary' }],
    detectedSegments: [{ text: '/ɒ/', tone: 'muted' }],
    diagnosis: '你的弱读 /ə/ 听起来有些接近 /ɒ/。',
    suggestion: '放松嘴唇和下颌，用更轻、更短的声音带过这个音。',
    encouragement: '单词整体已经很清楚，弱读自然一些会更流畅。',
  },
})
const stepList = [
  {
    id: 'fantastic',
    word: 'fantastic',
    ipa: '/fænˈtæstɪk/',
    ipaSegments: [{ text: '/fænˈtæstɪk/', tone: 'muted' }],
    audioUrl: '',
    stressIndex: 2,
    syllables: [
      { text: 'fan', emphasized: false },
      { text: 'tas', emphasized: true },
      { text: 'tic', emphasized: false },
    ],
    correction: {
      targetSegments: [{ text: '/æ/', tone: 'primary' }],
      detectedSegments: [{ text: '/e/', tone: 'muted' }],
      diagnosis: '你的 /æ/ 听起来更接近 /e/。',
      suggestion: '下颌再打开一些，嘴角向两侧展开后短促发音。',
      encouragement: '重音位置正确，再把开口度做明显一些即可。',
    },
  },
  {
    id: 'component',
    word: 'component',
    ipa: '/kəmˈpəʊnənt/',
    ipaSegments: [{ text: '/kəmˈpəʊnənt/', tone: 'muted' }],
    audioUrl: '',
    stressIndex: 2,
    syllables: [
      { text: 'com', emphasized: false },
      { text: 'po', emphasized: true },
      { text: 'nent', emphasized: false },
    ],
    correction: {
      targetSegments: [{ text: '/ə/', tone: 'primary' }],
      detectedSegments: [{ text: '/ɒ/', tone: 'muted' }],
      diagnosis: '你的弱读 /ə/ 听起来有些接近 /ɒ/。',
      suggestion: '放松嘴唇和下颌，用更轻、更短的声音带过这个音。',
      encouragement: '单词整体已经很清楚，弱读自然一些会更流畅。',
    },
  },
  {
    id: 'important',
    word: 'important',
    ipa: '/ɪmˈpɔːtənt/',
    ipaSegments: [{ text: '/ɪmˈpɔːtənt/', tone: 'muted' }],
    audioUrl: '',
    stressIndex: 2,
    syllables: [
      { text: 'im', emphasized: false },
      { text: 'por', emphasized: true },
      { text: 'tant', emphasized: false },
    ],
    correction: {
      targetSegments: [{ text: '/ɔː/', tone: 'primary' }],
      detectedSegments: [{ text: '/ɒ/', tone: 'muted' }],
      diagnosis: '你的 /ɔː/ 时长偏短，听起来更接近 /ɒ/。',
      suggestion: '保持嘴唇收圆，将元音平稳地延长一点。',
      encouragement: '音素位置已经接近，延长声音后会更准确。',
    },
  },
]
const resultVisible = ref(false)

function evaluateRecording() {
  // 后续在这里提交录音文件并更新评测结果。
  pageData.resultTitle = '本次评测结果'
  resultVisible.value = true
}

function beginRecording() {
  resultVisible.value = false
}

function loadStep(target: number) {
  const step = stepList[target - 1]
  if (step == null) return

  pageData.current = target
  pageData.word = step
  pageData.correction = step.correction
  pageData.resultTitle = '本次评测结果'
  resultVisible.value = false
}
</script>
<style lang="scss">
@import '../../uni.scss';
