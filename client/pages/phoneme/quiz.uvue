<template>
  <view class="page phoneme-quiz">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <text class="muted phoneme-quiz__category">{{ pageData.category }}</text>
    <text class="page-title">{{ pageData.question }}</text>
    <text class="muted phoneme-quiz__description">{{ pageData.description }}</text>
    <ListeningPrompt :audios="pageData.audios" />
    <text class="section-title">请选择</text>
    <ChoiceGroup
      :key="pageData.id"
      :options="pageData.options"
      @change="selectAnswer"
    />
    <TipCard :text="pageData.tip" />
    <button
      class="primary-button phoneme-quiz__confirm"
      :disabled="selectedAnswer.length === 0"
      @click="confirm"
    >
      确认答案
    </button>
    <DebugPageNav />
  </view>
</template>
<script lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import ListeningPrompt from '../../components/ListeningPrompt/index.uvue'
import ChoiceGroup from '../../components/ChoiceGroup/index.uvue'
export default {
  components: { LessonProgress, TipCard, ListeningPrompt, ChoiceGroup },
  data() {
    return {
      pageData: {
        id: 'short-vowel-quiz-2',
        current: 1,
        total: 3,
        category: '短元音练习',
        question: '你听到的是哪个音？',
        description: '先听发音，再选择对应的音标',
        tip: '注意声音是否短促，以及嘴巴张开的程度',
        audios: [{ id: 'target', text: '点击播放', url: '' }],
        options: [
          { label: 'A', text: '/ɪ/', value: 'short-i' },
          { label: 'B', text: '/iː/', value: 'long-i' },
          { label: 'C', text: '/e/', value: 'e' },
          { label: 'D', text: '/æ/', value: 'ae' },
        ],
        correctValue: 'ae',
      },
      questionList: [
        {
          id: 'short-vowel-quiz-1',
          question: '你听到的是哪个音？',
          description: '先听发音，再选择对应的音标',
          audios: [{ id: 'target', text: '点击播放', url: '' }],
          options: [
            { label: 'A', text: '/e/', value: 'e' },
            { label: 'B', text: '/æ/', value: 'ae' },
            { label: 'C', text: '/ʌ/', value: 'caret' },
            { label: 'D', text: '/ɒ/', value: 'short-o' },
          ],
          correctValue: 'ae',
        },
        {
          id: 'short-vowel-quiz-2',
          question: '哪个音更短促？',
          description: '听完两个发音后选择答案',
          audios: [
            { id: 'audio-a', text: '音频 A', url: '' },
            { id: 'audio-b', text: '音频 B', url: '' },
          ],
          options: [
            { label: 'A', text: '/ɪ/', value: 'short-i' },
            { label: 'B', text: '/iː/', value: 'long-i' },
          ],
          correctValue: 'short-i',
        },
        {
          id: 'short-vowel-quiz-3',
          question: '你听到的是长音还是短音？',
          description: '注意声音持续的时间',
          audios: [{ id: 'target', text: '点击播放', url: '' }],
          options: [
            { label: 'A', text: '长音', value: 'long' },
            { label: 'B', text: '短音', value: 'short' },
          ],
          correctValue: 'long',
        },
      ],
      selectedAnswer: '',
    }
  },
  methods: {
    selectAnswer(value: string) {
      this.selectedAnswer = value
    },
    confirm() {
      const target = this.pageData.current + 1
      const question = this.questionList[target - 1]
      if (question == null) return

      this.pageData.id = question.id
      this.pageData.current = target
      this.pageData.question = question.question
      this.pageData.description = question.description
      this.pageData.audios = question.audios
      this.pageData.options = question.options
      this.pageData.correctValue = question.correctValue
      this.selectedAnswer = ''
      uni.pageScrollTo({ scrollTop: 0, duration: 200 })
    },
  },
}
</script>
<style lang="scss">
@import '../../uni.scss';

.phoneme-quiz {
  &__category {
    display: block;
    margin-top: 36rpx;
  }

  &__description {
    display: block;
    margin-top: 10rpx;
    margin-bottom: 10rpx;
  }

  &__confirm {
    width: 100%;
    margin-top: 28rpx;

    &[disabled] {
      opacity: 0.45;
    }
  }
}
</style>
