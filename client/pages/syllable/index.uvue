<template>
  <view class="page">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <view class="center">
      <text class="page-title">{{ pageData.title }}</text>
      <text class="muted">{{ pageData.description }}</text>
    </view>
    <TipCard :title="pageData.tipTitle" :text="pageData.tip" />
    <view class="card word-card">
      <text class="word">{{ pageData.example.word }}</text>
      <text class="ipa">{{ pageData.example.ipa }}</text>
      <view class="chunks">
        <template v-for="(chunk, index) in pageData.example.chunks" :key="chunk.text">
          <text v-if="index > 0">·</text>
          <text :class="chunk.colorClass">{{ chunk.text }}</text>
        </template>
      </view>
    </view>
    <view class="card rules">
      <text class="section-title first">怎么判断</text>
      <view v-for="(rule, index) in pageData.rules" :key="rule.title" class="rule">
        <text class="number">{{ index + 1 }}</text>
        <view>
          <text class="rule-title">{{ rule.title }}</text>
          <text class="muted rule-text">{{ rule.text }}</text>
        </view>
      </view>
    </view>
    <view class="card question">
      <text>{{ pageData.question.text }}</text>
      <view class="answers">
        <text
          v-for="option in pageData.question.options"
          :key="option.value"
          :class="option.selected ? 'chosen' : ''"
        >
          {{ option.value }}
        </text>
      </view>
    </view>
    <StepActions :current="pageData.current" :total="pageData.total" @change="loadStep" />
  </view>
</template>
<script lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import StepActions from '../../components/StepActions/index.uvue'
export default {
  components: { LessonProgress, TipCard, StepActions },
  data() {
    return {
      pageData: {
        id: 'syllable-basic',
        current: 2,
        total: 8,
        title: '一个元音音素，一个音节',
        description: '每个音节都只有一个元音音素作为核心。',
        tipTitle: '记忆小贴士',
        tip: '看元音音素，不是数元音字母。',
        example: {
          word: 'computer',
          ipa: '/kəmˈpjuːtər/',
          chunks: [
            { text: 'kəm', colorClass: 'blue' },
            { text: 'pjuː', colorClass: 'green' },
            { text: 'tər', colorClass: 'purple' },
          ],
        },
        rules: [
          { title: '找元音音素', text: '找出单词中的元音音素。' },
          { title: '数出元音数量', text: '元音音素的数量 = 音节的数量。' },
          { title: '按发音节奏拆分', text: '每个元音音素为一个音节的核心。' },
        ],
        question: {
          text: 'computer 有几个音节？',
          options: [
            { value: 2, selected: false },
            { value: 3, selected: true },
            { value: 4, selected: false },
          ],
        },
        nextRoute: '/pages/decoding/ipa',
      },
    }
  },
  methods: {
    loadStep(target: number) {
      if (target < this.pageData.current) {
        uni.navigateBack()
        return
      }
      this.next()
    },
    next() {
      uni.navigateTo({ url: this.pageData.nextRoute })
    },
  },
}
</script>
<style lang="scss">
