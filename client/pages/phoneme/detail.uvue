  margin: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}
.slow {
  padding: 12rpx 18rpx;
  border: 1rpx solid $color-border;
  border-radius: 28rpx;
  color: $color-text-secondary;
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
}
.mouth-symbol {
  display: block;
  text-align: center;
  color: $color-primary;
  font-size: 160rpx;
  line-height: 180rpx;
}
.steps {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 330rpx;
  margin: auto;
  font-size: 25rpx;
}
.words {
  padding: 0;
}
.word-row {
  height: 78rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid $color-border;
  display: flex;
  align-items: center;
  gap: 26rpx;
}
.word-row:last-child {
  border: 0;
}
.word {
  width: 100rpx;
  font-weight: 600;
}
.meaning {
  margin-left: auto;
}
.compare {
  display: block;
  margin: 24rpx 4rpx;
  color: $color-primary;
  font-size: 24rpx;
}
</style>
