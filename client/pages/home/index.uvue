<template>
  <view class="screen">
    <view class="page home">
      <view class="home-head">
        <view>
          <text class="greeting">{{ pageData.greeting }}</text>
          <text class="subtitle">{{ pageData.subtitle }}</text>
        </view>
        <AppIcon name="search" :size="52" label="搜索" />
      </view>
      <TodayLessonCard :data="pageData.todayTask" @continue="go(pageData.todayTask.route)" />
      <text class="section-title">学习路径</text>
      <LearningPath
        v-if="learningSteps.length > 0"
        :steps="learningSteps"
        :current-index="safeCurrentIndex"
        @select="go"
      />
      <text class="section-title">常用功能</text>
      <QuickAccessList :items="pageData.quickAccess" @select="go" />
    </view>
    <BottomNav active="home" />
    <DebugPageNav />
  </view>
</template>
<script setup lang="uts">
import { storeToRefs } from 'pinia'
import BottomNav from '../../components/BottomNav/index.uvue'
import TodayLessonCard from '../../components/TodayLessonCard/index.uvue'
import LearningPath from '../../components/LearningPath/index.uvue'
import QuickAccessList from '../../components/QuickAccessList/index.uvue'
import type { StageItem } from '../../src/config/types.uts'
import { useLearningFlowStore } from '../../src/stores/learning-flow.uts'

const learningFlowStore = useLearningFlowStore()
const { templates, nodes, currentNodeIndex } = storeToRefs(learningFlowStore)

const pageData = reactive({
  greeting: '下午好，永庆',
  subtitle: '看到陌生单词，也能试着读出来',
  todayTask: {
    tag: '今日学习',
    title: '短元音 · 第 3 课',
    description: '区分 /ɪ/ 和 /iː/',
    durationMinutes: 6,
    actionText: '继续学习',
    route: '/pages/phoneme/compare',
    progressLabel: '基础学习',
    current: 8,
    total: 20,
  },
  quickAccess: [
    {
      code: 'phoneme-overview',
      name: '音标总览',
      description: '快速查阅',
      iconName: 'volume-2',
      route: '/pages/phoneme/overview',
    },
    {
      code: 'word-list',
      name: '专业词库',
      description: '实际应用',
      iconName: 'book-open',
      route: '/pages/word-list/index',
    },
  ],
})

const learningSteps = computed((): StageItem[] =>
  nodes.value.map((node, index): StageItem => {
    const template = templates.value.find((item) => item.code === node.templateCode)
    return {
      code: node.id,
      name: template == null ? '学习节点' : template.name,
      route: template == null ? '' : template.route,
      state:
        index < currentNodeIndex.value
          ? 'completed'
          : index === currentNodeIndex.value
            ? 'active'
            : 'pending',
    }
  })
)

const safeCurrentIndex = computed((): number =>
  Math.min(currentNodeIndex.value, Math.max(learningSteps.value.length - 1, 0))
)

onMounted(() => {
  learningFlowStore.loadFlow()
})

function go(url: string) {
  if (url.length === 0) return
  uni.navigateTo({ url })
}
</script>
<style lang="scss">
@import '../../uni.scss';

.screen {
  min-height: 100vh;
}
.home {
  width: 100vw;
  overflow-x: hidden;
  padding-top: 84rpx;
  padding-bottom: 164rpx;
}

.home-head {
  display: grid;
  grid-template-columns: 1fr auto;

  .greeting {
    display: block;
    font-size: 48rpx;
    font-weight: 700;
  }
  .subtitle {
    display: block;
    margin-top: 12rpx;
    color: $color-text-secondary;
  }
}
</style>
