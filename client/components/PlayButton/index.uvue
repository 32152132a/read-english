<template>
  <view
    class="play-button"
    :class="['play-button--' + buttonSize, disabled ? 'is-disabled' : '']"
    @click="play"
  >
    <view class="play-button__circle" :style="{ borderColor: color }">
      <view
        v-if="status === 'loading'"
        class="play-button__loading"
        :style="{ borderTopColor: color }"
      />
      <view v-else-if="status === 'playing'" class="play-button__playing">
        <view
          v-for="index in 3"
          :key="index"
          class="play-button__bar"
          :style="{ backgroundColor: color }"
        />
      </view>
      <AppIcon v-else-if="buttonSize === 'pill'" name="clock-3" :size="28" />
      <AppIcon v-else-if="icon === 'volume'" name="volume-2" :size="30" />
      <text v-else class="play-button__icon" :style="{ color: color }">▶</text>
    </view>
    <text v-if="text.length > 0" class="play-button__text" :style="{ color: color }">
      {{ text }}
    </text>
  </view>
</template>

<script setup lang="uts">
import type { PlayButtonProps, PlayStatus } from '../../src/config/types.uts'

// 临时播放占位音，接入真实音频数据后删除。
const TEMP_MOCK_AUDIO_URL = '/static/audio/mock-pronunciation.wav'

const props = withDefaults(defineProps<PlayButtonProps>(), {
  src: '',
  text: '',
  size: 'default',
  color: '#5267f8',
  icon: 'play',
  disabled: false,
})
const emit = defineEmits(['play', 'ended', 'error'])
const status = ref<PlayStatus>('idle')
let audioContext: InnerAudioContext | null = null
const buttonSize = computed((): string =>
  ['tiny', 'mini', 'large', 'hero', 'pill'].includes(props.size) ? props.size : 'default'
)

function play() {
  if (props.disabled || status.value !== 'idle') return

  status.value = 'loading'
  const audio = uni.createInnerAudioContext()
  audioContext = audio
  audio.src = props.src.length > 0 ? props.src : TEMP_MOCK_AUDIO_URL
  audio.onPlay(() => {
    status.value = 'playing'
    emit('play')
  })
  audio.onWaiting(() => {
    status.value = 'loading'
  })
  audio.onCanplay(() => {
    if (status.value === 'loading') status.value = 'playing'
  })
  audio.onEnded(() => {
    emit('ended')
    resetAudio()
  })
  audio.onError((error) => {
    resetAudio()
    emit('error', error)
  })
  audio.play()
}

function resetAudio() {
  audioContext?.destroy()
  audioContext = null
  status.value = 'idle'
}

onUnmounted(resetAudio)
</script>

<style lang="scss">
@import '../../uni.scss';

.play-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  width: fit-content;

  &__circle {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 66rpx;
    height: 66rpx;
    box-sizing: border-box;
    border: 2rpx solid $color-primary;
    border-radius: 50%;
  }

  &__icon {
    margin-left: 5rpx;
    font-size: 26rpx;
  }

  &__text {
    font-size: 26rpx;
  }

  &__loading {
    width: 24rpx;
    height: 24rpx;
    box-sizing: border-box;
    border: 3rpx solid $color-border;
    border-radius: 50%;
    animation: play-button-loading 0.8s linear infinite;
  }

  &__playing {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4rpx;
    height: 28rpx;
  }

  &__bar {
    width: 4rpx;
    height: 12rpx;
    border-radius: 4rpx;
    animation: play-button-playing 0.8s ease-in-out infinite alternate;

    &:nth-child(2) {
      animation-delay: 0.2s;
    }

    &:nth-child(3) {
      animation-delay: 0.4s;
    }
  }

  &--mini {
    gap: 10rpx;

    .play-button__circle {
      width: 48rpx;
      height: 48rpx;
    }

    .play-button__icon,
    .play-button__text {
      font-size: 22rpx;
    }
  }

  &--tiny {
    gap: 8rpx;

    .play-button__circle {
      width: 40rpx;
      height: 40rpx;
    }

    .play-button__icon,
    .play-button__text {
      font-size: 20rpx;
    }

    .play-button__loading {
      width: 18rpx;
      height: 18rpx;
      border-width: 2rpx;
    }
  }

  &--large {
    flex-direction: column;
    gap: 16rpx;

    .play-button__circle {
      width: 120rpx;
      height: 120rpx;
      border-width: 3rpx;
    }

    .play-button__icon {
      margin-left: 6rpx;
      font-size: 42rpx;
    }

    .play-button__text {
      font-size: 30rpx;
    }

    .play-button__loading {
      width: 38rpx;
      height: 38rpx;
      border-width: 4rpx;
    }

    .play-button__playing {
      gap: 6rpx;
      height: 44rpx;
    }

    .play-button__bar {
      width: 6rpx;
      height: 20rpx;
    }
  }

  &--hero {
    gap: 20rpx;

    .play-button__circle {
      width: 88rpx;
      height: 88rpx;
    }

    .play-button__icon {
      font-size: 32rpx;
    }

    .play-button__text {
      font-size: 30rpx;
      font-weight: 600;
    }
  }

  &--pill {
    min-height: 52rpx;
    padding: 0 20rpx;
    box-sizing: border-box;
    border: 2rpx solid $color-border;
    border-radius: 28rpx;
    gap: 8rpx;

    .play-button__circle {
      width: 28rpx;
      height: 28rpx;
      border: 0;
    }

    .play-button__text {
      color: $color-text-secondary !important;
      font-size: 23rpx;
    }
  }

  &.is-disabled {
    opacity: 0.45;
  }
}

@keyframes play-button-loading {
  to {
    transform: rotate(360deg);
  }
}

@keyframes play-button-playing {
  to {
    height: 100%;
  }
}
</style>
