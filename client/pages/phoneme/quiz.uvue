<template>
  <view class="page">
    <LessonProgress :current="pageData.current" :total="pageData.total" />
    <text class="muted kicker">{{ pageData.category }}</text>
    <text class="page-title">{{ pageData.question }}</text>
    <text class="muted desc">{{ pageData.description }}</text>
    <TipCard :text="pageData.tip" />
    <ListeningPrompt :audio-url="pageData.audioUrl" :description="pageData.replayTip" />
    <text class="section-title">请选择</text>
    <ChoiceGroup
      :options="pageData.options"
      :initial-value="pageData.selectedValue"
      @change="selectAnswer"
    />
    <button class="primary-button confirm" @click="confirm">确认答案</button>
  </view>
</template>
<script lang="uts">
import LessonProgress from '../../components/LessonProgress/index.uvue'
import TipCard from '../../components/TipCard/index.uvue'
import ListeningPrompt from '../../components/ListeningPrompt/index.uvue'
import ChoiceGroup from '../../components/ChoiceGroup/index.uvue'
export default {
  components: { LessonProgress, TipCard, ListeningPrompt, ChoiceGroup },
  data() {
    return {
      pageData: {
        id: 'short-vowel-quiz-2',
        current: 2,
        total: 6,
        category: '短元音练习',
        question: '你听到的是哪个音？',
        description: '先听发音，再选择对应的音标',
        tip: '注意声音是否短促，以及嘴巴张开的程度',
        replayTip: '可以反复播放',
        audioUrl: '',
        options: [
          { label: 'A', text: '/ɪ/', value: 'short-i' },
          { label: 'B', text: '/iː/', value: 'long-i' },
          { label: 'C', text: '/e/', value: 'e' },
          { label: 'D', text: '/æ/', value: 'ae' },
        ],
        selectedValue: 'ae',
        correctValue: 'ae',
        nextRoute: '/pages/phoneme/overview',
      },
      selectedAnswer: 'ae',
    }
  },
  methods: {
    selectAnswer(value: string) {
      this.selectedAnswer = value
    },
    confirm() {
      uni.navigateTo({ url: this.pageData.nextRoute })
    },
  },
}
</script>
